.hj-navbar {
  width: 100%;
  z-index: 100;
}

.hj-navbar.is-fixed {
  position: fixed;
  top: 0;
  left: 0;
}

.hj-navbar.is-transparent .hj-navbar-inner {
  background: transparent;
}

.hj-navbar-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  padding: 0 16px;
}

.hj-navbar-back {
  position: absolute;
  left: 8px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.hj-navbar-back-icon {
  width: 12px;
  height: 12px;
  border-left: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  transform: rotate(45deg);
  display: block;
  margin-left: 4px;
}

.hj-navbar-title {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  font-size: 17px;
  font-weight: 600;
}
