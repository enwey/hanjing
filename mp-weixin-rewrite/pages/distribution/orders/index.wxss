.distribution-orders-page { min-height: 100vh; background: #f5f6f8; padding-bottom: 32rpx; }
.distribution-order-tabs { white-space: nowrap; padding: 0 24rpx; }
.distribution-order-tab { display: inline-block; margin-right: 32rpx; padding-bottom: 14rpx; font-size: 28rpx; color: #6b7280; position: relative; }
.distribution-order-tab--active { color: #3b6bf5; font-weight: 600; }
.distribution-order-tab--active::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; border-radius: 9999rpx; background: #3b6bf5; }
.state-card { text-align: center; }
.state-title { display: block; font-size: 30rpx; font-weight: 700; color: #1f2937; }
.distribution-order-list-wrap { background: #ffffff; margin: 24rpx; border-radius: 16rpx; }
.distribution-order-list { display: flex; flex-direction: column; gap: 20rpx; }
.distribution-order-list { padding: 24rpx; }
.distribution-order-item { display: flex; gap: 20rpx; align-items: flex-start; }
.distribution-order-item + .distribution-order-item { padding-top: 24rpx; border-top: 1rpx solid #f3f4f6; }
.distribution-order-item__cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; overflow: hidden; background: #eef2f7; flex-shrink: 0; }
.distribution-order-item__cover-image { width: 100%; height: 100%; }
.distribution-order-item__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #f3f4f6; }
.distribution-order-item__placeholder-icon { width: 42rpx; height: 42rpx; }
.distribution-order-item__body { flex: 1; min-width: 0; }
.distribution-order-item__title { display: block; font-size: 28rpx; font-weight: 600; color: #1f2937; }
.distribution-order-item__meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: #6b7280; }
.distribution-order-item__commission { display: block; margin-top: 8rpx; font-size: 26rpx; font-weight: 600; color: #ef4444; }
.distribution-order-item__status { display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; flex-shrink: 0; }
.distribution-order-item__status--pending { color: #b45309; background: rgba(245, 158, 11, 0.14); }
.distribution-order-item__status--settled { color: #1a9d5c; background: rgba(26, 157, 92, 0.14); }
.distribution-order-item__status--refunded { color: #6b7280; background: rgba(107, 114, 128, 0.14); }
