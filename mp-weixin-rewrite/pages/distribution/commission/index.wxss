.distribution-commission-page { min-height: 100vh; background: #f5f6f8; padding-bottom: 32rpx; }
.state-card { text-align: center; }
.state-title { display: block; font-size: 30rpx; font-weight: 700; color: #1f2937; }
.commission-summary { display: flex; margin: 24rpx; background: #ffffff; border-radius: 20rpx; padding: 28rpx 0; }
.commission-summary__item { flex: 1; text-align: center; }
.commission-summary__value { display: block; font-size: 36rpx; font-weight: 700; color: #1f2937; }
.commission-summary__label { display: block; margin-top: 8rpx; font-size: 22rpx; color: #9ca3af; }
.commission-tabs { white-space: nowrap; padding: 0 24rpx; }
.commission-tab { display: inline-block; margin-right: 32rpx; padding-bottom: 14rpx; font-size: 28rpx; color: #6b7280; position: relative; }
.commission-tab--active { color: #3b6bf5; font-weight: 600; }
.commission-tab--active::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; border-radius: 9999rpx; background: #3b6bf5; }
.commission-list-wrap { background: #ffffff; margin: 24rpx; border-radius: 16rpx; }
.commission-list { padding: 24rpx; }
.commission-card { display: flex; align-items: center; gap: 20rpx; }
.commission-card + .commission-card { margin-top: 24rpx; }
.commission-card__cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; overflow: hidden; background: #eef2f7; flex-shrink: 0; }
.commission-card__cover-image { width: 100%; height: 100%; }
.commission-card__placeholder { width: 100%; height: 100%; background: #f3f4f6; }
.commission-card__body { flex: 1; min-width: 0; }
.commission-card__title { display: block; font-size: 28rpx; font-weight: 600; color: #1f2937; }
.commission-card__meta { display: block; margin-top: 8rpx; font-size: 22rpx; color: #6b7280; }
.commission-card__level { display: block; margin-top: 8rpx; font-size: 22rpx; color: #9ca3af; }
.commission-card__aside { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.commission-card__amount { font-size: 28rpx; font-weight: 600; color: #ef4444; }
.commission-card__status { display: inline-block; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; }
.commission-card__status--pending { color: #b45309; background: rgba(245, 158, 11, 0.14); }
.commission-card__status--settled { color: #1a9d5c; background: rgba(26, 157, 92, 0.14); }
.commission-card__status--refunded { color: #6b7280; background: rgba(107, 114, 128, 0.14); }
