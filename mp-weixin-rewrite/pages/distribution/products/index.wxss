.distribution-products-page { min-height: 100vh; background: #f5f6f8; padding-bottom: 32rpx; }
.state-card { text-align: center; }
.state-title { display: block; font-size: 30rpx; font-weight: 700; color: #1f2937; }
.product-list-wrap { background: #ffffff; margin: 24rpx; border-radius: 16rpx; }
.product-list { display: flex; flex-direction: column; gap: 20rpx; }
.product-list { padding: 24rpx; }
.product-card { display: flex; align-items: center; gap: 20rpx; }
.product-card + .product-card { padding-top: 24rpx; border-top: 1rpx solid #f3f4f6; }
.product-card__cover { width: 140rpx; height: 140rpx; border-radius: 12rpx; overflow: hidden; background: #eef2f7; flex-shrink: 0; }
.product-card__cover-image { width: 100%; height: 100%; }
.product-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #e8efff 0%, #f2f6ff 100%); }
.product-card__placeholder-icon { width: 44rpx; height: 44rpx; }
.product-card__body { flex: 1; min-width: 0; }
.product-card__name { display: block; font-size: 28rpx; font-weight: 600; color: #1f2937; }
.product-card__meta { display: block; margin-top: 8rpx; font-size: 24rpx; color: #6b7280; }
.product-card__arrow { font-size: 24rpx; color: #3b6bf5; flex-shrink: 0; }
