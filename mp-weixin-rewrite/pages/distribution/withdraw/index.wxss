.withdraw-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 32rpx;
}

.state-card {
  margin: 24rpx;
  padding: 40rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.state-description {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.balance-card {
  margin: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5a623, #f7c948);
}

.balance-card__label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-card__value {
  display: block;
  margin: 12rpx 0;
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
}

.balance-card__meta-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.balance-card__meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.withdraw-form {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.input-wrap {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f9fafb;
}

.amount-prefix {
  margin-right: 12rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #f5a623;
}

.amount-input {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  color: #1f2937;
}

.bank-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2937;
}

.method-row {
  display: flex;
  gap: 16rpx;
}

.method-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.method-card--active {
  border-color: #f5a623;
  background: #fff9e6;
}

.method-card__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  background: #f3f4f6;
}

.method-card--active .method-card__icon-wrap {
  background: #f5a623;
}

.method-card__icon {
  width: 26rpx;
  height: 26rpx;
}

.method-card__label {
  font-size: 26rpx;
  color: #4b5563;
}

.tip-box {
  margin-bottom: 24rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #fff9e6;
}

.tip-box__text {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #92400e;
}

.submit-button {
  margin: 32rpx 24rpx;
  padding: 28rpx 0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f5a623, #f7c948);
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-button--disabled {
  opacity: 0.5;
}

.records-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.records-entry__text {
  font-size: 26rpx;
  color: #6b7280;
}

.records-entry__arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
