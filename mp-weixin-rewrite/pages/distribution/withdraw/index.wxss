.withdraw-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 32rpx;
}

.state-card {
  margin: 24rpx;
  padding: 40rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
}

.state-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.state-description {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.balance-card {
  margin: 24rpx;
  padding: 36rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f5a623, #f7c948);
}

.balance-card__label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.balance-card__value {
  display: block;
  margin: 12rpx 0;
  font-size: 60rpx;
  font-weight: 700;
  color: #ffffff;
}

.balance-card__meta-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.balance-card__meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.withdraw-form {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid rgba(59, 107, 245, 0.08);
  border-radius: 18rpx;
  background: #f9fafb;
}

.amount-prefix {
  margin-right: 12rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #f5a623;
}

.withdraw-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 28rpx;
  color: #1f2937;
}

.withdraw-input__placeholder {
  font-size: 28rpx;
  color: #6b7280;
}

.amount-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #b91c1c;
}

.method-row {
  display: flex;
  gap: 16rpx;
}

.method-card {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.method-card--disabled {
  background: #f3f4f6;
}

.method-card--active {
  border-color: #f5a623;
  background: #fff9e6;
}

.method-card__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 12rpx;
  border-radius: 24rpx;
  background: #f3f4f6;
}

.method-card--active .method-card__icon-wrap {
  background: #fde7b4;
}

.method-card__icon {
  width: 30rpx;
  height: 30rpx;
}

.method-card__label {
  font-size: 26rpx;
  color: #4b5563;
}

.method-card--disabled .method-card__label {
  color: #6b7280;
}

.tip-box {
  margin-bottom: 24rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #fff9e6;
}

.tip-box__text {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #92400e;
}

.saved-cards {
  margin-bottom: 24rpx;
}

.saved-cards__header,
.saved-card,
.saved-card__title,
.saved-card__actions,
.bank-edit-actions {
  display: flex;
  align-items: center;
}

.saved-cards__header,
.saved-card {
  justify-content: space-between;
}

.saved-cards__header .form-label {
  margin-bottom: 0;
}

.saved-card {
  gap: 12rpx;
  margin-top: 12rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
}

.saved-card--selected {
  border-color: #f5a623;
  background: #fff9e6;
}

.saved-card__details {
  flex: 1;
  min-width: 0;
  padding: 16rpx 0 16rpx 20rpx;
}

.saved-card__title {
  gap: 12rpx;
}

.saved-card__bank {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.saved-card__selected {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #92400e;
}

.saved-card__meta {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  overflow-wrap: anywhere;
}

.saved-card__actions {
  flex-shrink: 0;
  padding-right: 8rpx;
}

.card-action {
  margin: 0;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #2a52d4;
}

.card-action[disabled] {
  color: #6b7280;
  background: transparent;
}

.bank-form-title {
  font-weight: 600;
}

.bank-edit-actions {
  justify-content: flex-end;
  gap: 16rpx;
}

.card-action--save {
  padding-right: 32rpx;
  padding-left: 32rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #3b6bf5;
}

.submit-button {
  margin: 32rpx 24rpx;
  padding: 28rpx 0;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #f5a623, #f7c948);
  color: #ffffff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-button--disabled {
  opacity: 0.5;
}

.records-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.records-entry__text {
  font-size: 26rpx;
  color: #6b7280;
}

.records-entry__arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.wechat-auth {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  background: #f3f8f6;
}

.wechat-auth__text {
  color: #475569;
  font-size: 24rpx;
  line-height: 1.5;
}

.wechat-auth .card-action {
  flex: 0 0 auto;
  min-height: 72rpx;
  border-radius: 10rpx;
  color: #176343;
  background: #e2f4ea;
}

.wechat-auth .card-action::after {
  border: 0;
}
