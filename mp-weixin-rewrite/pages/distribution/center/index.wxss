.distribution-center-page { min-height: 100vh; background: #f5f6f8; padding-bottom: 32rpx; }
.distribution-banner { margin: 24rpx; border-radius: 20rpx; overflow: hidden; position: relative; }
.distribution-banner__bg { position: absolute; inset: 0; background: linear-gradient(135deg, #f5a623, #f7c948); }
.distribution-banner__content { position: relative; padding: 32rpx 28rpx; }
.distribution-banner__title { font-size: 26rpx; color: rgba(255, 255, 255, 0.85); }
.distribution-banner__stats { display: flex; align-items: center; margin-top: 20rpx; }
.distribution-banner__stat { flex: 1; text-align: center; }
.distribution-banner__value { display: block; font-size: 36rpx; font-weight: 700; color: #ffffff; }
.distribution-banner__value--highlight { font-size: 44rpx; }
.distribution-banner__label { display: block; font-size: 22rpx; color: rgba(255, 255, 255, 0.75); margin-top: 4rpx; }
.distribution-banner__divider { width: 2rpx; height: 50rpx; background: rgba(255, 255, 255, 0.3); }
.distribution-actions { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0 24rpx 24rpx; background: #ffffff; border-radius: 16rpx; padding: 28rpx 0; }
.distribution-action { display: flex; flex-direction: column; align-items: center; }
.distribution-action__icon-wrap { width: 80rpx; height: 80rpx; border-radius: 40rpx; background: #eef4ff; display: flex; align-items: center; justify-content: center; }
.distribution-action__icon { width: 42rpx; height: 42rpx; }
.distribution-action__label { font-size: 24rpx; color: #4b5563; margin-top: 10rpx; }
.distribution-section { background: #ffffff; margin: 0 24rpx 24rpx; border-radius: 16rpx; padding: 24rpx; }
.distribution-section__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.distribution-section__title { font-size: 30rpx; font-weight: 600; color: #1f2937; }
.distribution-section__more { display: flex; align-items: center; gap: 4rpx; color: #3b6bf5; }
.distribution-section__more-text { display: block; font-size: 26rpx; line-height: 1.2; }
.distribution-section__more-arrow { display: flex; align-items: center; justify-content: center; width: 20rpx; height: 20rpx; color: inherit; }
.distribution-section__more-arrow::after { content: ''; width: 10rpx; height: 10rpx; border-top: 2rpx solid currentColor; border-right: 2rpx solid currentColor; transform: rotate(45deg); box-sizing: border-box; }
.distribution-order-list { min-height: 20rpx; }
.distribution-order-card { display: flex; align-items: center; padding: 0 0 20rpx; }
.distribution-order-card + .distribution-order-card { padding-top: 20rpx; border-top: 1rpx solid #f3f4f6; }
.distribution-order-card__cover-image, .distribution-order-card__placeholder { width: 112rpx; height: 112rpx; border-radius: 12rpx; background: #f3f4f6; flex-shrink: 0; }
.distribution-order-card__placeholder { display: flex; align-items: center; justify-content: center; }
.distribution-order-card__placeholder-icon { width: 36rpx; height: 36rpx; }
.distribution-order-card__body { flex: 1; margin-left: 20rpx; min-width: 0; }
.distribution-order-card__title { display: block; font-size: 28rpx; color: #1f2937; }
.distribution-order-card__meta { display: block; margin-top: 6rpx; font-size: 22rpx; color: #9ca3af; }
.distribution-order-card__amount { text-align: right; margin-left: 12rpx; }
.distribution-order-card__amount-value { display: block; font-size: 28rpx; color: #ef4444; font-weight: 600; }
.distribution-order-card__status { display: inline-block; margin-top: 6rpx; padding: 4rpx 14rpx; border-radius: 8rpx; font-size: 22rpx; }
.distribution-order-card__status--pending { color: #b45309; background: rgba(245, 158, 11, 0.14); }
.distribution-order-card__status--settled { color: #1a9d5c; background: rgba(26, 157, 92, 0.14); }
.distribution-order-card__status--refunded { color: #6b7280; background: rgba(107, 114, 128, 0.14); }
.distribution-rule-card { background: #ffffff; border-radius: 16rpx; padding: 24rpx; }
.distribution-rule-card + .distribution-rule-card { margin-top: 20rpx; }
.distribution-rule-card__title { display: block; font-size: 30rpx; font-weight: 600; color: #1f2937; margin-bottom: 16rpx; }
.distribution-rule-card__desc { display: block; font-size: 26rpx; line-height: 1.8; color: #4b5563; }
.distribution-level-head, .distribution-level-row { display: flex; align-items: center; padding: 18rpx 0; }
.distribution-level-head { border-bottom: 1rpx solid #f3f4f6; }
.distribution-level-row { border-bottom: 1rpx solid #f9fafb; }
.distribution-level-row:last-child { border-bottom: none; }
.distribution-level-col { flex: 1; text-align: center; font-size: 24rpx; color: #4b5563; }
.distribution-level-col--strong { font-weight: 600; color: #1f2937; }
.distribution-rule-item { display: flex; align-items: flex-start; padding: 14rpx 0; }
.distribution-rule-item__index { width: 40rpx; height: 40rpx; border-radius: 20rpx; background: #eef4ff; color: #3b6bf5; font-size: 22rpx; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 16rpx; }
.distribution-rule-item__text { flex: 1; font-size: 26rpx; line-height: 1.8; color: #4b5563; }
