<view class="container distribution-center-page">
  <hj-navbar title="分销中心" showBack="{{true}}" />

  <view class="distribution-banner">
    <view class="distribution-banner__bg"></view>
    <view class="distribution-banner__content">
      <text class="distribution-banner__title">我的推广</text>
      <view class="distribution-banner__stats">
        <view class="distribution-banner__stat">
          <text class="distribution-banner__value">{{totalCommissionLabel}}</text>
          <text class="distribution-banner__label">累计佣金</text>
        </view>
        <view class="distribution-banner__divider"></view>
        <view class="distribution-banner__stat">
          <text class="distribution-banner__value distribution-banner__value--highlight">{{availableCommissionLabel}}</text>
          <text class="distribution-banner__label">可提现</text>
        </view>
        <view class="distribution-banner__divider"></view>
        <view class="distribution-banner__stat">
          <text class="distribution-banner__value">{{teamCountLabel}}</text>
          <text class="distribution-banner__label">团队成员</text>
        </view>
      </view>
    </view>
  </view>

  <view class="distribution-actions">
    <view wx:for="{{actionEntries}}" wx:key="label" class="distribution-action" data-url="{{item.url}}" bindtap="openEntry">
      <view class="distribution-action__icon-wrap">
        <image src="{{item.icon}}" mode="aspectFit" class="distribution-action__icon" />
      </view>
      <text class="distribution-action__label">{{item.label}}</text>
    </view>
  </view>

  <view class="distribution-section">
    <view class="distribution-section__header">
      <text class="distribution-section__title">近期推广订单</text>
      <text class="distribution-section__more" data-url="/pages/distribution/orders/index" bindtap="openEntry">全部</text>
    </view>
    <view class="distribution-order-list">
      <view wx:for="{{recentOrders}}" wx:key="id" class="distribution-order-card">
        <image wx:if="{{item.hasImage}}" src="{{item.image}}" mode="aspectFill" class="distribution-order-card__cover-image" />
        <view wx:else class="distribution-order-card__placeholder">
          <image src="/static/icons/distribution.svg" mode="aspectFit" class="distribution-order-card__placeholder-icon" />
        </view>
        <view class="distribution-order-card__body">
          <text class="distribution-order-card__title">{{item.name}}</text>
          <text class="distribution-order-card__meta">{{item.buyerName}} | {{item.dateLabel}}</text>
        </view>
        <view class="distribution-order-card__amount">
          <text class="distribution-order-card__amount-value">+{{item.commissionText}}</text>
          <text class="distribution-order-card__status distribution-order-card__status--{{item.statusClass}}">{{item.statusText}}</text>
        </view>
      </view>
      <hj-empty wx:if="{{!recentOrders.length && !loading}}" title="暂无推广订单" />
    </view>
  </view>

  <view class="distribution-section">
    <view class="distribution-rule-entry" data-url="/pages/distribution/rules/index" bindtap="openEntry">
      <text class="distribution-rule-entry__text">分销规则与说明</text>
      <text class="distribution-rule-entry__arrow">&gt;</text>
    </view>
  </view>
</view>
