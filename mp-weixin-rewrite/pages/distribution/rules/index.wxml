<view class="container distribution-rules-page">
  <hj-navbar title="分销规则" showBack="{{true}}" />

  <view class="distribution-rules-content">
    <view class="distribution-rule-card">
      <text class="distribution-rule-card__title">开通条件</text>
      <text wx:if="{{qualificationText}}" class="distribution-rule-card__desc">{{qualificationText}}</text>
      <text wx:else class="distribution-rule-card__desc">当前暂无分销开通说明</text>
    </view>

    <view class="distribution-rule-card" wx:if="{{commissionRules.length}}">
      <text class="distribution-rule-card__title">佣金规则</text>
      <view wx:for="{{commissionRules}}" wx:key="index" class="distribution-rule-item">
        <text class="distribution-rule-item__index">{{index + 1}}</text>
        <text class="distribution-rule-item__text">{{item}}</text>
      </view>
    </view>

    <view class="distribution-rule-card" wx:if="{{promotionWays.length}}">
      <text class="distribution-rule-card__title">推广方式</text>
      <view wx:for="{{promotionWays}}" wx:key="index" class="distribution-rule-item">
        <text class="distribution-rule-item__index">{{index + 1}}</text>
        <text class="distribution-rule-item__text">{{item}}</text>
      </view>
    </view>

    <view class="distribution-rule-card" wx:if="{{withdrawRules.length}}">
      <text class="distribution-rule-card__title">提现规则</text>
      <view wx:for="{{withdrawRules}}" wx:key="index" class="distribution-rule-item">
        <text class="distribution-rule-item__index">{{index + 1}}</text>
        <text class="distribution-rule-item__text">{{item}}</text>
      </view>
    </view>
  </view>
</view>
