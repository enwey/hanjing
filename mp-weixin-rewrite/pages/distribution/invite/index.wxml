<view class="container invite-page">
  <hj-navbar title="邀请好友" showBack="{{true}}" />
  <view class="invite-heading">
    <image class="invite-heading__art" src="/static/images/invite-sleep-letter.jpg" mode="aspectFill" />
    <view class="invite-heading__copy">
      <view class="invite-brand">
        <image class="invite-brand__logo" src="/static/images/brand-koala.png" mode="aspectFit" />
        <text>兴康明</text>
      </view>
      <text class="invite-heading__title">好眠邀请函</text>
      <text class="invite-heading__subtitle">把一夜好眠的心愿，<text class="invite-heading__accent">送给你在乎的人。</text></text>
    </view>
    <text class="invite-heading__signature">一份关心 · 一起好眠</text>
  </view>
  <view class="invite-content">
    <view class="invite-pass">
      <view class="invite-pass__header">
        <text class="invite-pass__title">为你留好，一份健康关怀</text>
        <text class="invite-pass__label">专属邀请</text>
      </view>
      <view class="invite-pass__qr-area">
        <view class="invite-qr">
          <image wx:if="{{inviteQrCode}}" class="invite-qr__image" src="{{inviteQrCode}}" mode="aspectFit" />
          <view wx:else class="invite-qr__fallback">
            <image class="invite-qr__brand" src="/static/images/brand-koala.png" mode="aspectFit" />
            <text>{{hasLoaded ? '使用邀请码邀请' : '正在加载邀请信息'}}</text>
          </view>
        </view>
        <view class="invite-pass__message">
          <text class="invite-pass__qr-caption">从关注睡眠开始<text class="invite-pass__message-line">多一点对自己的照顾</text></text>
          <text class="invite-pass__qr-note">{{inviteQrCode ? '扫码接受邀请，认识兴康明' : '分享邀请链接，认识兴康明'}}</text>
        </view>
      </view>
      <view class="invite-code-row">
        <view class="invite-code">
          <text class="invite-code__label">专属邀请码</text>
          <text class="invite-code__value" selectable="{{true}}">{{inviteCode || '—'}}</text>
        </view>
        <button class="invite-copy" bindtap="handleCopyInviteCode" disabled="{{!inviteCode}}">复制</button>
      </view>
    </view>
    <view wx:if="{{qrUnavailableNotice}}" class="invite-notice">
      <image class="invite-notice__icon" src="/static/icons/info.svg" mode="aspectFit" />
      <text>小程序码暂不可用，您仍可分享邀请链接或复制邀请码。</text>
    </view>
    <view class="invite-guide">
      <text class="invite-guide__title">分享关怀，也收获奖励</text>
      <view class="invite-guide__steps">
        <view class="invite-guide__step">
          <text class="invite-guide__number">01</text>
          <text class="invite-guide__name">分享邀请</text>
          <text class="invite-guide__desc">发送给好友</text>
        </view>
        <view class="invite-guide__step">
          <text class="invite-guide__number">02</text>
          <text class="invite-guide__name">好友加入</text>
          <text class="invite-guide__desc">完成邀请绑定</text>
        </view>
        <view class="invite-guide__step">
          <text class="invite-guide__number">03</text>
          <text class="invite-guide__name">获得奖励</text>
          <text class="invite-guide__desc">按推广规则结算</text>
        </view>
      </view>
      <text class="invite-guide__note">邀请关系及佣金结算以实际绑定结果和推广规则为准。</text>
    </view>
  </view>
  <view class="invite-actions">
    <button class="invite-actions__button invite-actions__button--secondary" bindtap="handleSavePoster" loading="{{isSavingPoster}}" disabled="{{isSavingPoster || !inviteCode}}">
      <image wx:if="{{!isSavingPoster}}" class="invite-actions__icon" src="/static/icons/poster-save-share-style.svg" mode="aspectFit" />
      <text>{{isSavingPoster ? '生成中' : '保存海报'}}</text>
    </button>
    <button class="invite-actions__button invite-actions__button--primary" open-type="share" disabled="{{!inviteCode}}">
      <image class="invite-actions__icon invite-actions__icon--light" src="/static/icons/paper-plane.svg" mode="aspectFit" />
      <text>把关怀送给好友</text>
    </button>
  </view>
  <canvas id="distributionInvitePoster" canvas-id="distributionInvitePoster" type="2d" class="poster-canvas" style="width: {{posterWidth}}px; height: {{posterHeight}}px;" disable-scroll="{{true}}"></canvas>
</view>
