.invite-page { min-height:100vh; background:#eef4ff; color:#1f2937; padding-bottom:calc(150rpx + env(safe-area-inset-bottom)); }
.invite-content { padding:24rpx; max-width:860rpx; margin:0 auto; }
.invite-title,.invite-subtitle,.invite-message { display:block; position:relative; z-index:1; }
.invite-card { position:relative; margin-top:-32rpx; background:#fff; border-radius:28rpx; padding:36rpx 30rpx 28rpx; }
.invite-qr { width:220rpx; height:220rpx; flex-shrink:0; }
.invite-qr__image { width:100%; height:100%; }
.invite-qr__fallback { width:100%; height:100%; border-radius:20rpx; background:#eef4ff; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:18rpx; color:#2a52d4; font-size:22rpx; }
.invite-qr__fallback image { width:80rpx; height:80rpx; border-radius:20rpx; }
.invite-details { flex:1; min-width:0; }
.invite-entry__title { display:block; font-size:26rpx; font-weight:500; line-height:1.5; }
.invite-entry__desc,.invite-code-label { display:block; color:#6b7280; font-size:22rpx; margin-top:8rpx; line-height:1.5; }
.invite-code { display:block; font-size:28rpx; color:#2a52d4; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.invite-copy { display:inline-flex; padding:0; margin:8rpx 0 0; background:transparent; color:#3b6bf5; font-size:22rpx; line-height:1.8; }
.invite-copy::after,.invite-button::after { border:0; }
.invite-actions { position:fixed; bottom:0; left:0; right:0; z-index:40; display:flex; gap:20rpx; padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background:#fff; border-top:1rpx solid #e5e7eb; }
.invite-button { display:flex; align-items:center; justify-content:center; min-width:0; margin:0; padding:0 12rpx; height:88rpx; border-radius:18rpx; font-size:28rpx; font-weight:600; line-height:1.4; }
.invite-button--save { flex:1; color:#2a52d4; background:#eef4ff; }
.invite-button--share { flex:1.7; color:#fff; background:#3b6bf5; }
.invite-button[disabled] { color:#9ca3af; background:#f3f4f6; }
.poster-canvas { position:fixed; left:-9999rpx; top:-9999rpx; pointer-events:none; opacity:0; }
.invite-hero { position:relative; overflow:hidden; height:830rpx; border-radius:28rpx 28rpx 0 0; padding:32rpx; color:#2a52d4; }
.invite-art { position:absolute; inset:0; width:100%; height:100%; }
.invite-brand { position:relative; display:flex; align-items:center; gap:14rpx; font-size:28rpx; font-weight:600; }
.invite-title { margin-top:28rpx; font-size:70rpx; line-height:1.25; font-weight:700; letter-spacing:2rpx; }
.invite-subtitle { margin-top:12rpx; font-size:34rpx; line-height:1.5; font-weight:500; }
.invite-entry { display:flex; align-items:center; justify-content:center; gap:36rpx; }
.invite-code-label { margin-top:0; }
.invite-guide { margin-top:24rpx; background:#fff; padding:28rpx 24rpx; border-radius:24rpx; }
.invite-guide__header { display:flex; align-items:center; justify-content:space-between; font-size:28rpx; font-weight:600; }
.invite-steps { display:flex; gap:12rpx; margin-top:26rpx; }
.invite-steps > view { flex:1; min-width:0; text-align:center; }
.invite-step-number { display:flex; justify-content:center; align-items:center; width:44rpx; height:44rpx; margin:0 auto 14rpx; background:#eef4ff; color:#3b6bf5; border-radius:50%; font-size:24rpx; }
.invite-step-title { display:block; font-size:25rpx; line-height:1.5; }
.invite-step-desc { display:block; margin-top:8rpx; font-size:20rpx; color:#6b7280; line-height:1.6; }
.invite-brand image { width:60rpx; height:60rpx; flex-shrink:0; border-radius:16rpx; background:#fff; }
.invite-rules { margin-top:24rpx; padding:28rpx; border-radius:24rpx; background:#fff; }
.invite-rules__title { display:block; font-size:28rpx; font-weight:600; }
.invite-rules__section { margin-top:24rpx; }
.invite-rules__heading { display:block; margin-bottom:10rpx; font-size:25rpx; font-weight:500; color:#374151; }
.invite-rules__item,.invite-rules__status { display:block; font-size:24rpx; line-height:1.8; color:#6b7280; overflow-wrap:anywhere; }
.invite-rules__item + .invite-rules__item { margin-top:8rpx; }
.invite-rules__status { margin-top:16rpx; }
.invite-rules__retry { margin:16rpx 0 0; padding:0; text-align:left; font-size:24rpx; line-height:1.8; color:#3b6bf5; background:transparent; }
.invite-rules__retry::after { border:0; }

.invite-diagnostics { margin-top:24rpx; padding:28rpx; border-radius:24rpx; background:#fff; }
.invite-diagnostics__text { display:block; margin-top:16rpx; font-size:24rpx; line-height:1.7; color:#374151; white-space:pre-wrap; word-break:break-all; }
.invite-diagnostics__actions { display:flex; gap:16rpx; margin-top:20rpx; }
.invite-diagnostics__actions button { flex:1; margin:0; padding:12rpx 8rpx; font-size:24rpx; line-height:1.6; background:#eef4ff; color:#3b6bf5; border-radius:12rpx; }
.invite-diagnostics__actions button::after { border:0; }
