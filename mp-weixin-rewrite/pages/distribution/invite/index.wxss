.invite-page { min-height: 100vh; background: #f2f3f5; padding-bottom: calc(132rpx + env(safe-area-inset-bottom, 34px)); box-sizing: border-box; }
.invite-content { padding-top: 16rpx; }
.invite-banner { position: relative; margin: 16rpx 24rpx 24rpx; padding: 30rpx 28rpx; border-radius: 36rpx; overflow: hidden; background: linear-gradient(135deg, #f5b743 0%, #f39b1a 100%); box-shadow: 0 16rpx 40rpx rgba(243, 155, 26, 0.22); }
.invite-banner__glow { position: absolute; top: -36rpx; right: -36rpx; width: 180rpx; height: 180rpx; border-radius: 9999rpx; background: radial-gradient(circle, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0) 72%); filter: blur(8rpx); }
.invite-banner__content { position: relative; z-index: 1; }
.invite-banner__title { display: block; font-size: 38rpx; font-weight: 700; color: #ffffff; letter-spacing: 1rpx; }
.invite-banner__desc { display: block; margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; color: rgba(255, 255, 255, 0.92); }
.invite-banner__tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.invite-tag { padding: 8rpx 16rpx; border-radius: 9999rpx; background: rgba(255, 255, 255, 0.16); border: 1rpx solid rgba(255, 255, 255, 0.24); color: #ffffff; font-size: 20rpx; line-height: 1.2; }
.invite-poster-section { margin: 0 24rpx 24rpx; }
.invite-poster-section__header { display: flex; align-items: center; justify-content: space-between; }
.invite-poster-section__title { display: block; font-size: 30rpx; font-weight: 700; color: #1c1a17; }
.invite-poster-section__subtitle { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8c857b; }
.invite-notice { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 18rpx; padding: 18rpx 20rpx; background: #ffffff; border: 1rpx solid #e8edf5; border-radius: 24rpx; }
.invite-notice__icon { width: 28rpx; height: 28rpx; margin-top: 2rpx; flex-shrink: 0; }
.invite-notice__text { display: block; font-size: 22rpx; line-height: 1.6; color: #8c857b; }
.invite-poster-preview { padding: 18rpx 8rpx 0; }
.invite-poster { position: relative; overflow: hidden; padding: 28rpx 24rpx 34rpx; border-radius: 36rpx; background: #3b6bf5; color: #ffffff; text-align: center; box-shadow: 0 18rpx 44rpx rgba(59, 107, 245, 0.2); border: 1rpx solid rgba(255, 255, 255, 0.1); }
.invite-poster__wave { position: absolute; left: 0; right: 0; bottom: 86rpx; height: 2rpx; background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0)); }
.invite-poster__top { display: block; position: relative; z-index: 1; font-size: 18rpx; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.76); }
.invite-poster__body { position: relative; z-index: 1; padding-top: 14rpx; }
.invite-poster__copy { margin-bottom: 24rpx; }
.invite-poster__kicker { display: block; font-size: 18rpx; letter-spacing: 3rpx; color: rgba(255, 255, 255, 0.9); }
.invite-poster__headline { display: block; margin-top: 14rpx; font-size: 48rpx; font-weight: 700; color: #ffffff; letter-spacing: 1rpx; }
.invite-poster__subhead { display: block; margin-top: 8rpx; font-size: 24rpx; font-weight: 400; color: rgba(255, 255, 255, 0.84); }
.invite-poster__qr { width: 210rpx; height: 210rpx; margin: 0 auto; border-radius: 30rpx; background: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.14); }
.invite-poster__qr-image { width: 176rpx; height: 176rpx; border-radius: 18rpx; }
.invite-poster__code-box { padding: 16rpx; text-align: center; }
.invite-poster__code-label { display: block; font-size: 18rpx; color: #8c857b; }
.invite-poster__code-value { display: block; margin-top: 10rpx; font-size: 26rpx; font-weight: 700; color: #3b6bf5; word-break: break-all; }
.invite-poster__chip { display: inline-flex; align-items: center; justify-content: center; margin-top: 22rpx; padding: 10rpx 22rpx; border-radius: 9999rpx; background: rgba(255, 255, 255, 0.15); border: 1rpx solid rgba(255, 255, 255, 0.2); }
.invite-poster__chip-text { display: block; font-size: 20rpx; color: #ffffff; letter-spacing: 0.5rpx; }
.invite-poster__bottom { display: block; position: relative; z-index: 1; margin-top: 28rpx; font-size: 22rpx; color: rgba(255, 255, 255, 0.8); }
.invite-guide { margin: 0 24rpx 24rpx; padding: 28rpx 24rpx 10rpx; border-radius: 30rpx; background: #ffffff; }
.invite-guide__title { font-size: 30rpx; font-weight: 700; color: #1c1a17; }
.invite-guide__flow { position: relative; padding-top: 20rpx; }
.invite-guide__line { position: absolute; left: 26rpx; top: 38rpx; bottom: 30rpx; width: 2rpx; background: linear-gradient(180deg, rgba(243, 155, 26, 0.28), rgba(243, 155, 26, 0.04)); }
.invite-guide__step { position: relative; display: flex; align-items: flex-start; gap: 16rpx; padding-bottom: 28rpx; }
.invite-guide__number { width: 52rpx; height: 52rpx; border-radius: 9999rpx; background: #fff7e7; border: 1rpx solid rgba(243, 155, 26, 0.35); color: #f39b1a; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; flex-shrink: 0; position: relative; z-index: 1; }
.invite-guide__content { flex: 1; padding-top: 4rpx; }
.invite-guide__step-title { display: block; font-size: 28rpx; font-weight: 600; color: #1c1a17; }
.invite-guide__step-desc { display: block; margin-top: 8rpx; font-size: 24rpx; line-height: 1.7; color: #8c857b; }
.invite-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom, 34px)); background: rgba(251, 250, 247, 0.95); backdrop-filter: blur(12rpx); box-shadow: 0 -12rpx 32rpx rgba(15, 23, 42, 0.08); }
.invite-actions__button { height: 92rpx; border-radius: 9999rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.invite-actions__button--secondary { flex: 1; background: #ffffff; border: 1rpx solid #e5e5e5; color: #53555B; }
.invite-actions__button--primary { flex: 1.2; color: #ffffff; background: linear-gradient(135deg, #f5b743 0%, #f39b1a 100%); }
.invite-actions__icon { width: 30rpx; height: 30rpx; }
.invite-actions__icon--light { filter: brightness(0) invert(1); }
.invite-actions__text { font-size: 28rpx; font-weight: 600; }
.poster-canvas { position: fixed; left: -9999rpx; top: -9999rpx; width: 900rpx; height: 1220rpx; pointer-events: none; opacity: 0; }
