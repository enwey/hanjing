.community-detail-page {
  --detail-text: #1f2937;
  --detail-muted: #64748b;
  --detail-line: #e7edf4;
  --detail-blue: #2a52d4;
  min-height: 100vh;
  background: #f3f4f6;
}

.post-card.state-card { padding: 48rpx 28rpx; text-align: center; }
.state-title { display: block; font-size: 30rpx; font-weight: 700; color: var(--detail-text); }
.state-desc { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: var(--detail-muted); }
.state-button { display: inline-flex; align-items: center; justify-content: center; min-width: 220rpx; min-height: 44px; margin-top: 18rpx; border-radius: 16rpx; background: var(--detail-blue); color: #ffffff; font-size: 26rpx; font-weight: 600; }

.community-detail-content { padding: 24rpx 24rpx 0; }

.post-card,
.comment-section {
  border: 1rpx solid var(--detail-line);
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
}

.post-card { padding: 24rpx 24rpx 4rpx; }

.post-header,
.post-author__row,
.post-report {
  display: flex;
  align-items: center;
}

.post-header { gap: 16rpx; }
.post-author__row { gap: 8rpx; flex-wrap: wrap; }
.post-author { flex: 1; min-width: 0; }

.post-avatar,
.comment-item__avatar,
.comment-bar__avatar {
  position: relative;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 50%;
  background: #eef2ff;
}

.post-avatar { width: 72rpx; height: 72rpx; }

.post-avatar__placeholder,
.post-avatar__image,
.comment-item__avatar-placeholder,
.comment-item__avatar-image,
.comment-bar__avatar-placeholder,
.comment-bar__avatar-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.post-avatar__image,
.comment-item__avatar-image,
.comment-bar__avatar-image { opacity: 0; }
.post-avatar__image--loaded,
.comment-item__avatar-image--loaded,
.comment-bar__avatar-image--loaded { opacity: 1; }

.post-author__name,
.comment-item__author {
  min-width: 0;
  overflow-wrap: anywhere;
  color: var(--detail-text);
  font-weight: 600;
}

.post-author__name { font-size: 28rpx; line-height: 40rpx; }
.post-author__role { padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 22rpx; line-height: 30rpx; }
.role--doctor { background: #eef4ff; color: var(--detail-blue); }
.role--expert { background: #f5f3ff; color: #7c3aed; }
.role--patient { background: #e8f8ef; color: #157347; }

.post-author__time,
.comment-item__time {
  display: block;
  color: var(--detail-muted);
  font-size: 22rpx;
  line-height: 32rpx;
}

.post-author__time { margin-top: 2rpx; }

.post-header__actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
  margin-right: -8rpx;
}

.post-delete,
.post-report {
  flex-shrink: 0;
  justify-content: center;
  gap: 6rpx;
  min-width: 44px;
  min-height: 44px;
  padding: 0 8rpx;
  color: var(--detail-muted);
  border-radius: 12rpx;
}

.post-delete { color: #b91c1c; }
.post-delete__text { font-size: 24rpx; line-height: 36rpx; }
.post-report__icon { display: block; width: 28rpx; height: 28rpx; }
.post-report__text { font-size: 24rpx; line-height: 36rpx; }

.post-title {
  display: block;
  margin-top: 24rpx;
  color: var(--detail-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.post-rich-content {
  display: block;
  margin-top: 14rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
}

.post-cover { display: block; width: 100%; height: 376rpx; margin-top: 20rpx; border-radius: 16rpx; background: #f3f4f6; }

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 18rpx;
}

.post-category,
.post-tag { max-width: 100%; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 22rpx; line-height: 32rpx; overflow-wrap: anywhere; }
.post-tag { color: #475569; background: #f1f5f9; }
.tag-theme--blue { color: var(--detail-blue); background: #e8f0ff; }
.tag-theme--green { color: #157347; background: #e8f8ef; }
.tag-theme--orange { color: #9a3412; background: #fff3df; }
.tag-theme--amber { color: #92400e; background: #fff8db; }
.tag-theme--pink { color: #9d174d; background: #fce7f3; }
.tag-theme--violet { color: #6d28d9; background: #f3e8ff; }

.post-actions {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4rpx;
  margin-top: 20rpx;
  border-top: 1rpx solid var(--detail-line);
}

.post-action,
.comment-item__action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 44px;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 12rpx;
  color: #475569;
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

.post-action { width: 100%; min-width: 0; }
.post-action__icon,
.comment-item__action-icon { display: block; flex-shrink: 0; width: 32rpx; height: 32rpx; }

.post-action__count {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  font-variant-numeric: tabular-nums;
}

.post-action--liked,
.comment-item__action--liked { color: #b91c1c; }
.post-action--favorited { color: #92400e; }

.post-action:active,
.post-report:active,
.comment-item__action:active,
.comment-bar__close:active,
.comment-bar__emoji-toggle:active { background: #eef4ff; }

.comment-section { margin-top: 20rpx; }

.comment-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid var(--detail-line);
}

.comment-section__title { color: var(--detail-text); font-size: 30rpx; line-height: 42rpx; font-weight: 700; }
.comment-section__total { color: var(--detail-muted); font-size: 24rpx; line-height: 36rpx; }

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 20rpx 24rpx 2rpx;
}

.comment-item + .comment-item { border-top: 1rpx solid var(--detail-line); }
.comment-item--highlight { background: #eef4ff; box-shadow: inset 4rpx 0 0 #3b6bf5; }
.comment-item--deleted { padding-bottom: 18rpx; }
.comment-item__content--deleted { color: #94a3b8; font-style: italic; }
.comment-item__avatar { width: 56rpx; height: 56rpx; }
.comment-item__main { flex: 1; min-width: 0; }

.comment-item__header {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 12rpx;
}

.comment-item__author { font-size: 26rpx; line-height: 38rpx; }

.comment-item__content {
  margin-top: 6rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.comment-item__reply-prefix { color: var(--detail-blue); font-weight: 500; }
.comment-item__actions { display: flex; align-items: center; gap: 8rpx; margin-top: 2rpx; }
.comment-item__action { min-width: 44px; justify-content: flex-start; }
.comment-item__reply-link { color: var(--detail-blue); font-weight: 500; }
.comment-item__delete-link { color: #b91c1c; }
.comment-item__report-link { color: var(--detail-muted); }

.comment-empty { padding: 28rpx 24rpx; text-align: center; }
.comment-empty__title { display: block; color: var(--detail-text); font-size: 28rpx; font-weight: 600; }
.comment-empty__desc { display: block; margin-top: 6rpx; color: var(--detail-muted); font-size: 24rpx; line-height: 1.6; }

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 20;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom, 0px));
  background: #ffffff;
  border-top: 1rpx solid var(--detail-line);
}

.comment-bar--keyboard { padding-bottom: 12rpx; }
.comment-bar__row { display: flex; align-items: center; gap: 14rpx; }
.comment-bar__avatar { width: 56rpx; height: 56rpx; }

.comment-bar__reply {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 44px;
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #3b6bf5;
  border-radius: 8rpx;
  background: #eef4ff;
}

.comment-bar__reply-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--detail-blue);
  font-size: 24rpx;
  line-height: 36rpx;
}

.comment-bar__close {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  color: #475569;
  font-size: 36rpx;
  line-height: 1;
}

.comment-bar__field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 17rpx 20rpx;
  border: 1rpx solid var(--detail-line);
  border-radius: 16rpx;
  background: #f8fafc;
}

.comment-bar__textarea {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  color: var(--detail-text);
}

.comment-bar__textarea,
.comment-bar__placeholder {
  font-size: 28rpx;
  line-height: 44rpx;
}

.comment-bar__placeholder { color: var(--detail-muted); }

.comment-bar__emoji-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 16rpx;
}

.comment-bar__emoji-toggle--active { background: #eef4ff; }
.comment-bar__toggle-icon { display: block; width: 48rpx; height: 48rpx; }

.comment-emoji-panel {
  display: flex;
  flex-direction: column;
  max-height: 48vh;
  margin: 12rpx -24rpx -12rpx;
  padding: 8rpx 24rpx;
  border-top: 1rpx solid var(--detail-line);
  background: #f8fafc;
}

.comment-emoji-panel__scroll { flex: 1; min-height: 0; }
.comment-emoji-panel__grid {
  display: grid;
  grid-template-columns: repeat(8, minmax(0, 1fr));
  min-height: 100%;
  align-content: space-evenly;
  gap: 4rpx;
}

.comment-emoji-panel__emoji {
  width: 100%;
  min-height: 36px;
  border-radius: 12rpx;
  font-size: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.comment-emoji-panel__emoji:active { background: #e2e8f0; }
.comment-emoji-panel__actions { display: flex; justify-content: flex-end; padding: 4rpx 0; }
.comment-emoji-panel__delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12rpx;
  background: #ffffff;
  color: #334155;
  font-size: 32rpx;
  line-height: 1;
}

.comment-emoji-panel__delete[disabled] { color: #94a3b8; }
.comment-bar button { margin: 0; }

.detail-loading {
  padding-bottom: calc(58px + env(safe-area-inset-bottom, 0px));
}

.detail-loading__block {
  border-radius: 8rpx;
  background: #e8eef4;
  animation: detail-loading-pulse 1.6s ease-in-out 160ms infinite;
}

.detail-loading__block.post-avatar,
.detail-loading__block.comment-item__avatar,
.detail-loading__block.comment-bar__avatar { border-radius: 50%; background: #e8eef4; }

.detail-loading .post-header { min-height: 44px; }
.detail-loading__author { width: 44%; height: 24rpx; }
.detail-loading__meta { width: 35%; height: 16rpx; margin-top: 10rpx; }
.detail-loading__title { width: 74%; height: 32rpx; margin-top: 30rpx; }
.detail-loading__body { display: flex; flex-direction: column; gap: 22rpx; margin-top: 26rpx; }
.detail-loading__line { width: 100%; height: 20rpx; }
.detail-loading__line--medium { width: 91%; }
.detail-loading__line--short { width: 63%; }
.detail-loading__tag { width: 88rpx; height: 36rpx; }
.detail-loading__action { display: flex; align-items: center; justify-content: center; min-height: 44px; }
.detail-loading__action-mark { width: 42rpx; height: 22rpx; }
.detail-loading__section-title { width: 124rpx; height: 42rpx; }
.detail-loading__comment { padding-bottom: 24rpx; }
.detail-loading__comment .detail-loading__line { margin-top: 12rpx; }
.detail-loading__comment-action { width: 106rpx; height: 20rpx; margin-top: 20rpx; }
.detail-loading__field { flex: 1; min-width: 0; height: 44px; border-radius: 16rpx; }
.detail-loading__switch { flex-shrink: 0; width: 36rpx; height: 36rpx; margin: 0 calc((44px - 36rpx) / 2); border-radius: 50%; }
.detail-loading__footer { bottom: 0; pointer-events: none; }

@keyframes detail-loading-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.58; }
}

@media (prefers-reduced-motion: reduce) {
  .detail-loading__block { animation: none; }
}

.official-badge {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: var(--detail-blue);
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
}

.official-badge__icon { display: block; width: 22rpx; height: 22rpx; }
