.community-publish-page { min-height: 100vh; background: #f5f6f8; padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 150rpx); }
.publish-form { padding: 24rpx 24rpx 32rpx; }
.publish-editor, .publish-options { background: #fff; border-radius: 24rpx; padding: 28rpx; }
.publish-options { margin-top: 20rpx; }
.publish-field__label { display: block; margin-bottom: 16rpx; font-size: 28rpx; line-height: 1.4; color: #1f2937; font-weight: 600; }
.publish-field--title { padding-bottom: 24rpx; border-bottom: 1rpx solid #eef0f4; }
.publish-field--content { padding-top: 24rpx; }
.publish-options .publish-field + .publish-field { margin-top: 32rpx; }
.publish-category-list, .publish-tag-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.publish-chip { display: flex; align-items: center; justify-content: center; min-height: 80rpx; padding: 0 22rpx; box-sizing: border-box; border-radius: 16rpx; background: #f4f6f9; font-size: 26rpx; line-height: 1.4; color: #596578; }
.publish-chip--active { background: #eaf0ff; color: #315edb; font-weight: 600; }
.publish-field__input, .publish-field__textarea { width: 100%; padding: 0; box-sizing: border-box; background: transparent; color: #1f2937; }
.publish-field__input { height: 72rpx; font-size: 30rpx; line-height: 1.5; }
.publish-field__textarea { height: 280rpx; font-size: 28rpx; line-height: 1.65; }
.publish-placeholder { color: #a0a9b7; }
.publish-field__count { display: block; margin-top: 16rpx; text-align: right; font-size: 24rpx; line-height: 1.4; color: #8b95a4; }
.publish-submit-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom, 0px)); background: rgba(255,255,255,0.98); box-shadow: 0 -8rpx 24rpx rgba(15,23,42,0.04); }
.publish-submit-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: 18rpx; background: #3b6bf5; color: #fff; font-size: 30rpx; font-weight: 600; }
.publish-submit-button--disabled { background: #b8c7ef; }

.publish-state { padding: 72rpx 32rpx; text-align:center; color:#6b7280; line-height:1.8; }
.publish-state text { display:block; margin-bottom:20rpx; }
.publish-state__title { display:block; color:#24334a; font-size:30rpx; font-weight:600; margin-bottom:12rpx; }
.publish-review-note { margin-bottom:24rpx; padding:24rpx; border-radius:16rpx; background:#fff4e5; color:#78551e; font-size:26rpx; line-height:1.7; overflow-wrap:break-word; }
