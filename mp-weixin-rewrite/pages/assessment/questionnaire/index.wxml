<view class="page data-v-c4ff781e">
  <hj-navbar title="ESS嗜睡量表" showBack="{{true}}" bindback="handleBack" />
  <view class="page-content data-v-c4ff781e">
    <picker mode="selector" range="{{memberNames}}" value="{{memberIndex}}" bindchange="onMemberChange" class="member-picker data-v-c4ff781e">
      <view class="member-picker-content data-v-c4ff781e">
        <view class="member-info data-v-c4ff781e">
          <text class="member-label data-v-c4ff781e">当前评测人：</text>
          <text class="member-value data-v-c4ff781e">{{selectedMemberName}}</text>
        </view>
        <view class="member-action data-v-c4ff781e">
          <text class="member-action-text data-v-c4ff781e">切换</text>
          <image class="member-action-arrow data-v-c4ff781e" src="/static/icons/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
    </picker>
    <view wx:if="{{isPageReady && questions.length}}" class="question-card data-v-c4ff781e">
      <text class="question-title data-v-c4ff781e">第{{questions[currentQuestionIndex].id || (currentQuestionIndex + 1)}}题</text>
      <text class="question-situation data-v-c4ff781e">{{questions[currentQuestionIndex].situation}}</text>
      <text class="question-hint data-v-c4ff781e">💡 {{questions[currentQuestionIndex].hint}}</text>
      <view class="options-list data-v-c4ff781e">
        <view wx:for="{{answerOptions}}" wx:key="score" class="option-item data-v-c4ff781e {{answers[currentQuestionIndex] === item.score ? 'is-selected' : ''}}" data-score="{{item.score}}" bindtap="selectAnswer">
          <text class="option-emoji data-v-c4ff781e">{{item.emoji}}</text>
          <text class="option-label data-v-c4ff781e">{{item.label}}</text>
          <view class="option-radio data-v-c4ff781e {{answers[currentQuestionIndex] === item.score ? 'checked' : ''}}">
            <text wx:if="{{answers[currentQuestionIndex] === item.score}}" class="data-v-c4ff781e">✓</text>
          </view>
        </view>
      </view>
    </view>
    <view class="dots data-v-c4ff781e">
      <view wx:for="{{totalQuestions}}" wx:key="*this" class="dot data-v-c4ff781e {{answers[index] >= 0 ? 'completed' : ''}} {{index === currentQuestionIndex ? 'current' : ''}}" data-index="{{index}}" bindtap="handleDotClick"></view>
    </view>
    <view class="bottom-actions data-v-c4ff781e">
      <view wx:if="{{currentQuestionIndex > 0}}" class="btn-prev data-v-c4ff781e" bindtap="prevQuestion"><text class="data-v-c4ff781e">‹ 上一题</text></view>
      <view wx:if="{{currentQuestionIndex < totalQuestions - 1}}" class="btn-next data-v-c4ff781e" bindtap="nextQuestion"><text class="data-v-c4ff781e">下一题 ›</text></view>
      <view wx:if="{{currentQuestionIndex === totalQuestions - 1}}" class="btn-submit data-v-c4ff781e {{isSubmitting ? 'is-submitting' : ''}}" bindtap="submitQuestionnaire"><text class="data-v-c4ff781e">{{isSubmitting ? '正在生成报告...' : '提交评估'}}</text></view>
    </view>
    <text wx:if="{{isSubmitting}}" class="submit-hint data-v-c4ff781e">正在生成您的 ESS 评估报告，请稍候...</text>
    <view class="safe-bottom data-v-c4ff781e"></view>
  </view>
</view>
