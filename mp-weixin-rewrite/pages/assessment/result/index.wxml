<view class="page data-v-1973d3c1">
  <hj-navbar title="评估结果" showBack="{{true}}" />
  <view class="page-content data-v-1973d3c1">
    <view wx:if="{{isLoading}}" class="empty-state data-v-1973d3c1">
      <text class="empty-desc data-v-1973d3c1">正在加载评估结果...</text>
    </view>
    <view wx:elif="{{hasLoaded && !resultDetail}}" class="empty-state data-v-1973d3c1">
      <view class="empty-icon-img data-v-1973d3c1" style="-webkit-mask-image: url(/static/icons/report.svg); mask-image: url(/static/icons/report.svg); background-color: #94a3b8;"></view>
      <text class="empty-title data-v-1973d3c1">暂无评估结果</text>
      <text class="empty-desc data-v-1973d3c1">请先完成 ESS 嗜睡量表评估</text>
      <view class="btn-retake data-v-1973d3c1" bindtap="restartAssessment">开始评估</view>
    </view>
    <block wx:else>
      <view class="score-card data-v-1973d3c1" style="background: {{levelInfo.color}}">
        <text class="score-label data-v-1973d3c1">ESS 评分</text>
        <text class="score-value data-v-1973d3c1">{{score}}</text>
        <text class="score-unit data-v-1973d3c1">/ 24 分</text>
        <text class="score-level data-v-1973d3c1">{{levelInfo.level}}</text>
      </view>
      <view class="result-card data-v-1973d3c1">
        <view class="result-title-container data-v-1973d3c1">
          <view class="title-icon data-v-1973d3c1" style="-webkit-mask-image: url(/static/icons/trend.svg); mask-image: url(/static/icons/trend.svg); background-color: #3b6bf5;"></view>
          <text class="result-title data-v-1973d3c1">评分解读</text>
        </view>
        <text class="result-desc data-v-1973d3c1">{{levelInfo.desc}}</text>
      </view>
      <view class="result-card data-v-1973d3c1">
        <view class="result-title-container data-v-1973d3c1">
          <view class="title-icon data-v-1973d3c1" style="-webkit-mask-image: url(/static/icons/report.svg); mask-image: url(/static/icons/report.svg); background-color: #3b6bf5;"></view>
          <text class="result-title data-v-1973d3c1">答案回顾</text>
        </view>
        <view class="answer-list data-v-1973d3c1">
          <view wx:for="{{answerReviewList}}" wx:key="questionId" class="answer-item data-v-1973d3c1">
            <text class="answer-q data-v-1973d3c1">第{{item.index}}题. {{item.situation}}</text>
            <text class="answer-s data-v-1973d3c1" style="{{item.style}}">{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="advice-card data-v-1973d3c1" style="background: {{levelInfo.adviceBg}}; border-color: {{levelInfo.adviceBorder}}">
        <view class="advice-header-container data-v-1973d3c1">
          <view class="advice-icon-img data-v-1973d3c1" style="-webkit-mask-image: url({{levelInfo.adviceIcon}}); mask-image: url({{levelInfo.adviceIcon}}); background-color: {{levelInfo.adviceTitleColor}};"></view>
          <text class="advice-title data-v-1973d3c1" style="color: {{levelInfo.adviceTitleColor}}">专业建议</text>
        </view>
        <text class="advice-text data-v-1973d3c1" style="color: {{levelInfo.adviceTextColor}}">{{levelInfo.advice}}</text>
      </view>
      <view class="action-buttons data-v-1973d3c1">
        <view class="btn-primary data-v-1973d3c1" bindtap="goAppointment">立即预约门诊</view>
        <view class="btn-secondary data-v-1973d3c1" bindtap="goHome">返回睡眠评估</view>
        <view class="btn-outline data-v-1973d3c1" bindtap="restartAssessment">重新评估</view>
      </view>
    </block>
  </view>
</view>
