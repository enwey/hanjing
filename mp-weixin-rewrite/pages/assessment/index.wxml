<view class="page data-v-35dabd14">
  <hj-navbar title="睡眠评估" />
  <view class="page-content data-v-35dabd14">
    <view class="sync-card data-v-35dabd14" wx:if="{{pendingCount > 0}}">
      <view class="sync-info data-v-35dabd14">
        <text class="sync-icon data-v-35dabd14">🔄</text>
        <text class="sync-text data-v-35dabd14">您有 {{pendingCount}} 条离线鼾声分析记录待同步</text>
      </view>
      <button class="sync-btn data-v-35dabd14" bindtap="handleForceSync">立即同步</button>
    </view>
    <picker wx:if="{{isLoggedIn && memberNames.length}}" mode="selector" range="{{memberNames}}" value="{{memberIndex}}" bindchange="onMemberChange" class="member-picker data-v-35dabd14">
      <view class="member-picker-content data-v-35dabd14">
        <view class="member-info data-v-35dabd14">
          <text class="member-label data-v-35dabd14">当前评估人：</text>
          <text class="member-value data-v-35dabd14">{{selectedMemberName}}</text>
        </view>
        <view class="member-action data-v-35dabd14">
          <text class="member-action-text data-v-35dabd14">切换</text>
          <image class="member-action-arrow data-v-35dabd14" src="/static/icons/chevron-right.svg" mode="aspectFit" />
        </view>
      </view>
    </picker>
    <view class="hero-card data-v-35dabd14">
      <image class="hero-emoji data-v-35dabd14" src="/static/icons/assessment_purple.svg" />
      <text class="hero-title data-v-35dabd14">了解您的睡眠质量</text>
      <text class="hero-desc data-v-35dabd14">通过专业的ESS嗜睡量表和AI鼾声分析，全面评估您的睡眠呼吸健康状况</text>
    </view>
    <view class="eval-card data-v-35dabd14" bindtap="startEssAssessment">
      <image class="eval-icon data-v-35dabd14" src="/static/icons/assessment.svg" />
      <view class="eval-info data-v-35dabd14">
        <text class="eval-title data-v-35dabd14">ESS嗜睡量表</text>
        <text class="eval-desc data-v-35dabd14">8道情境题 · 约3分钟 · 国际通用标准</text>
      </view>
      <text class="eval-arrow data-v-35dabd14">›</text>
    </view>
    <view class="eval-card data-v-35dabd14" bindtap="startSnoreAssessment">
      <image class="eval-icon data-v-35dabd14" src="/static/icons/microphone.svg" />
      <view class="eval-info data-v-35dabd14">
        <view class="eval-title-wrapper data-v-35dabd14">
          <text class="eval-title data-v-35dabd14">AI鼾声分析</text>
          <view class="new-tag data-v-35dabd14">新增上线</view>
        </view>
        <text class="eval-desc data-v-35dabd14">录制鼾声 · AI分析 · 风险评级</text>
      </view>
      <text class="eval-arrow data-v-35dabd14">›</text>
    </view>
    <view class="section-header data-v-35dabd14"><text class="section-title data-v-35dabd14">我的评估记录</text></view>
    <view wx:if="{{records.length}}">
      <view wx:for="{{records}}" wx:key="id" class="record-card data-v-35dabd14" data-record-id="{{item.id}}" data-type="{{item.type}}" bindtap="openRecord">
        <view class="record-left data-v-35dabd14">
          <view class="record-type-dot data-v-35dabd14" style="background: {{item.levelColor}}"></view>
          <view class="record-info data-v-35dabd14">
            <text class="record-type data-v-35dabd14">{{item.typeLabel}}</text>
            <text class="record-desc data-v-35dabd14">{{item.summary}}{{item.recommendation ? '，' + item.recommendation : ''}}</text>
            <text class="record-date data-v-35dabd14">{{item.dateLabel}}</text>
          </view>
        </view>
        <view class="record-right data-v-35dabd14">
          <text class="record-level data-v-35dabd14" style="color: {{item.levelColor}}">{{item.levelLabel}}</text>
          <text class="record-arrow data-v-35dabd14">›</text>
        </view>
      </view>
    </view>
    <view wx:elif="{{loading || loadError}}" class="empty-card data-v-35dabd14">
      <text class="empty-text data-v-35dabd14">{{loading ? '加载评估记录中...' : loadError}}</text>
    </view>
    <view wx:else class="empty-card data-v-35dabd14">
      <view class="empty-icon-wrap data-v-35dabd14">
        <image class="empty-icon data-v-35dabd14" src="/static/icons/assessment.svg" mode="aspectFit" />
      </view>
      <text class="empty-text data-v-35dabd14">暂无评估记录</text>
      <text class="empty-hint data-v-35dabd14">完成评估后可在此查看报告</text>
    </view>
    <view class="safe-bottom data-v-35dabd14"></view>
    <hj-privacy-popup id="privacyPopup" />
  </view>
</view>
