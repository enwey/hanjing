@import "./index.wxss";
.business-card{margin:16px;padding:20px 18px;background:#fff;border-radius:12px;min-width:0}
.business-title{display:block;font-size:17px;font-weight:600;color:#24334a;line-height:26px}
.business-section{margin-top:20px;padding-top:16px;border-top:1px solid #edf0f5}
.business-subtitle{display:block;margin-bottom:12px;font-size:14px;font-weight:600;color:#4b5d75;line-height:22px}
.business-field{display:flex;align-items:flex-start;gap:14px;margin-top:12px;font-size:14px;line-height:23px}
.business-label{flex:0 0 72px;color:#7c899c}
.business-value{flex:1;min-width:0;color:#24334a;word-break:break-all;white-space:pre-wrap}
.business-hint{display:block;margin-top:20px;font-size:13px;line-height:22px;color:#64748b}
.reply-image{display:block;width:100%;margin-top:16px;border-radius:8px}
.detail-actions{padding:0 16px calc(env(safe-area-inset-bottom) + 24px)}
.detail-actions .detail-action{margin:12px 0 0;min-height:44px;line-height:44px;border-radius:10px}
.detail-action--secondary{background:#edf3ff;color:var(--color-primary-500,#3b6bf5)}
.detail-action::after{border:0}

.detail-content{word-break:normal;overflow-wrap:break-word;}
