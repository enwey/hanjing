<view class="page data-v-c3158b61">
  <hj-navbar title="消息通知" showBack="{{true}}" />
  <view class="top-bar data-v-c3158b61">
    <text class="unread-text data-v-c3158b61">{{unreadCount}} 条未读</text>
    <text wx:if="{{unreadCount > 0}}" class="read-all data-v-c3158b61" bindtap="markAllRead">全部已读</text>
  </view>
  <view class="page-content data-v-c3158b61">
    <view wx:if="{{loading}}" class="loading-wrap data-v-c3158b61"><text class="data-v-c3158b61">加载中...</text></view>
    <block wx:else>
      <view
        wx:for="{{notifications}}"
        wx:key="id"
        class="noti-card data-v-c3158b61 {{!item.isRead ? 'unread' : ''}}"
        data-id="{{item.id}}"
        bindtap="openNotification"
      >
        <view class="noti-dot data-v-c3158b61 {{!item.isRead ? 'active' : ''}}" />
        <view class="noti-icon data-v-c3158b61" style="background: {{item.iconBg}}; color: {{item.iconColor}}">
          <text class="data-v-c3158b61">{{item.iconText}}</text>
        </view>
        <view class="noti-body data-v-c3158b61">
          <text class="noti-title data-v-c3158b61">{{item.title}}</text>
          <text class="noti-content data-v-c3158b61">{{item.content}}</text>
          <text class="noti-time data-v-c3158b61">{{item.timeText}}</text>
        </view>
      </view>
      <view wx:if="{{!notifications.length}}" class="empty data-v-c3158b61"><text class="data-v-c3158b61">暂无消息</text></view>
    </block>
    <view class="safe-bottom data-v-c3158b61" />
  </view>
</view>
