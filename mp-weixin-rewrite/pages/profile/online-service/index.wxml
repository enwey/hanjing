<view class="page data-v-72504f8b">
  <hj-navbar title="{{serviceTitle}}" showBack="{{true}}" />
  <view class="service-banner">
    <text class="service-banner__text">{{serviceSubtitle}}</text>
  </view>
  <scroll-view class="chat-area data-v-72504f8b" scroll-y scroll-into-view="{{scrollIntoView}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="chat-list data-v-72504f8b">
      <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="chat-msg data-v-72504f8b {{item.rowClass}}">
        <view class="msg-bubble data-v-72504f8b {{item.bubbleClass}}">
          <image wx:if="{{item.isImg}}" src="{{item.displayUrl}}" mode="widthFix" bindtap="onPreviewImage" data-src="{{item.displayUrl}}" style="max-width: 320rpx; border-radius: 12rpx; display: block; margin-bottom: 8rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);" />
          <text wx:else class="msg-text data-v-72504f8b">{{item.text}}</text>
          <text wx:if="{{item.sending}}" style="font-size: 20rpx; color: #999; margin-right: 10rpx;">发送中...</text>
          <text wx:if="{{item.failed}}" catchtap="retrySendMessage" data-id="{{item.id}}" style="font-size: 20rpx; color: #ff4d4f; margin-right: 10rpx; text-decoration: underline; z-index: 10;">⚠️ 失败重试</text>
          <text class="msg-time data-v-72504f8b">{{item.time}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
  <view class="input-bar data-v-72504f8b">
    <view bindtap="onUploadImage" style="padding: 10rpx 15rpx 10rpx 10rpx; display: flex; align-items: center; justify-content: center; font-size: 44rpx; color: #6b7280; z-index: 100;">📷</view>
    <input class="chat-input data-v-72504f8b" placeholder="输入您的问题..." bindconfirm="sendMessage" value="{{inputText}}" bindinput="handleInput" />
    <view class="btn-send data-v-72504f8b" bindtap="sendMessage"><text class="data-v-72504f8b">发送</text></view>
  </view>
</view>
