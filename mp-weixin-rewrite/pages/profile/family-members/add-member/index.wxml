<view class="page data-v-33d45858">
  <hj-navbar title="{{isEdit ? '成员详情' : '添加家庭成员'}}" showBack="{{true}}" />
  <view class="page-content data-v-33d45858">
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">姓名</text>
      <input class="form-input data-v-33d45858" placeholder="请输入姓名" value="{{name}}" bindinput="handleNameInput" disabled="{{isSelf}}" />
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">关系</text>
      <view class="form-chips data-v-33d45858">
        <view
          wx:for="{{relationOptions}}"
          wx:key="value"
          class="chip data-v-33d45858 {{relation === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="selectRelation"
        >
          <text class="data-v-33d45858">{{item.label}}</text>
        </view>
      </view>
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">性别</text>
      <view class="form-chips data-v-33d45858">
        <view class="chip data-v-33d45858 {{gender === '1' ? 'active' : ''}}" data-value="1" bindtap="selectGender"><text class="data-v-33d45858">男</text></view>
        <view class="chip data-v-33d45858 {{gender === '2' ? 'active' : ''}}" data-value="2" bindtap="selectGender"><text class="data-v-33d45858">女</text></view>
      </view>
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">年龄</text>
      <input class="form-input data-v-33d45858" type="number" placeholder="请输入年龄" value="{{age}}" bindinput="handleAgeInput" disabled="{{isSelf}}" />
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">手机号（选填）</text>
      <input class="form-input data-v-33d45858" type="number" placeholder="用于匹配已存在档案，可单独填写" value="{{phone}}" bindinput="handlePhoneInput" disabled="{{isSelf}}" />
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">身份证号（选填）</text>
      <input class="form-input data-v-33d45858" placeholder="用于匹配已存在档案，可单独填写" value="{{idCard}}" bindinput="handleIdCardInput" disabled="{{isSelf}}" />
    </view>
    <view class="form-group data-v-33d45858">
      <text class="form-label data-v-33d45858">病历号（就诊卡号）（选填）</text>
      <input class="form-input data-v-33d45858" placeholder="用于匹配已存在档案，可单独填写" value="{{cardNo}}" bindinput="handleCardNoInput" disabled="{{isSelf}}" />
    </view>
    <view class="bottom-fixed-bar data-v-33d45858" wx:if="{{!isSelf}}">
      <block wx:if="{{isEdit}}">
        <button class="bar-primary-btn bar-save-btn data-v-33d45858" bindtap="submitAddMember">保存修改</button>
        <button class="bar-danger-btn bar-delete-btn data-v-33d45858" bindtap="deleteMember">解除关联</button>
      </block>
      <block wx:else>
        <button class="bar-primary-btn data-v-33d45858" bindtap="submitAddMember">确认关联</button>
      </block>
    </view>
    <view class="safe-bottom data-v-33d45858" style="{{isSelf ? 'height: 40rpx;' : ''}}" />
  </view>
</view>
