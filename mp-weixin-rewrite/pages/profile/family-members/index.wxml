<view class="page data-v-30acdad2">
  <hj-navbar title="家庭成员" showBack="{{true}}"></hj-navbar>
  <view class="page-content data-v-30acdad2">
    <view wx:if="{{loading}}" class="loading-wrap data-v-30acdad2">
      <text class="data-v-30acdad2">加载中...</text>
    </view>
    <block wx:else>
      <view
        wx:for="{{members}}"
        wx:key="id"
        class="member-card data-v-30acdad2"
        data-id="{{item.id}}"
        bindtap="goMemberDetail"
      >
        <view class="member-avatar data-v-30acdad2">
          <image class="member-avatar-placeholder data-v-30acdad2" src="/static/images/brand-koala.png" mode="aspectFill" />
        </view>
        <view class="member-info data-v-30acdad2">
          <view class="member-name-row data-v-30acdad2">
            <text class="member-name data-v-30acdad2">{{item.name}}</text>
            <text class="member-relation data-v-30acdad2">{{item.relationLabel}}</text>
          </view>
          <text class="member-detail data-v-30acdad2">{{item.genderLabel}} | {{item.ageLabel ? item.ageLabel + '岁' : '未填写'}} | {{item.phone || '未填写'}}</text>
          <view wx:if="{{item.idCard}}" class="member-visit data-v-30acdad2" style="margin-top: 6rpx; color: #6b7280; font-size: 22rpx;">身份证: {{item.idCard}}</view>
          <view wx:if="{{item.cardNo}}" class="member-visit data-v-30acdad2" style="margin-top: 4rpx; color: #6b7280; font-size: 22rpx;">档案卡: {{item.cardNo}}</view>
          <text wx:if="{{item.hasSnore}}" class="member-tag data-v-30acdad2">有打鼾</text>
          <text wx:if="{{item.lastVisit}}" class="member-visit data-v-30acdad2">上次服务: {{item.lastVisit}}</text>
        </view>
      </view>
      <view wx:if="{{!members.length}}" class="empty data-v-30acdad2">
        <text class="data-v-30acdad2">暂无已关联服务对象</text>
      </view>
    </block>
    <view class="bottom-fixed-bar data-v-30acdad2">
      <button class="bar-primary-btn data-v-30acdad2" bindtap="goAddMember">+ 添加家庭成员</button>
    </view>
    <view class="safe-bottom data-v-30acdad2"></view>
  </view>
</view>
