<view class="page data-v-bf62d399">
  <hj-navbar title="会员权益" showBack="{{true}}" />
  <view class="page-content data-v-bf62d399">
    <view wx:if="{{loading}}" class="loading-wrap data-v-bf62d399"><text class="data-v-bf62d399">加载中...</text></view>
    <block wx:elif="{{memberInfo}}">
      <view class="level-card data-v-bf62d399" style="background: {{levelCardBg}}">
        <text class="level-title data-v-bf62d399">{{currentLevelTitle}}</text>
        <view class="level-stats data-v-bf62d399">
          <view class="stat-item data-v-bf62d399">
            <text class="stat-val data-v-bf62d399">{{totalSpentText}}</text>
            <text class="stat-label data-v-bf62d399">累计消费</text>
          </view>
          <view class="stat-item data-v-bf62d399">
            <text class="stat-val data-v-bf62d399">{{pointsText}}</text>
            <text class="stat-label data-v-bf62d399">积分</text>
          </view>
        </view>
        <view wx:if="{{needUpgrade}}" class="progress-section data-v-bf62d399">
          <text class="progress-hint data-v-bf62d399">再消费 {{nextLevelDiffText}} 升级{{nextLevelTitle}}</text>
          <view class="progress-bar data-v-bf62d399">
            <view class="progress-fill data-v-bf62d399" style="width: {{progressWidth}}" />
          </view>
        </view>
      </view>
      <view class="section data-v-bf62d399">
        <text class="section-title data-v-bf62d399">当前权益</text>
        <view class="benefit-list data-v-bf62d399">
          <view wx:for="{{currentBenefits}}" wx:key="key" class="benefit-item data-v-bf62d399">
            <view class="benefit-icon data-v-bf62d399" style="background: {{item.iconBg}}">
              <image class="benefit-icon-image data-v-bf62d399" src="{{item.icon}}" mode="aspectFit" />
            </view>
            <view class="benefit-body data-v-bf62d399">
              <text class="benefit-title data-v-bf62d399">{{item.title}}</text>
              <text class="benefit-desc data-v-bf62d399">{{item.desc}}</text>
            </view>
            <view class="benefit-check data-v-bf62d399">
              <image class="benefit-check-icon data-v-bf62d399" src="/static/icons/success-medical.svg" mode="aspectFit" />
            </view>
          </view>
        </view>
      </view>
      <view class="section data-v-bf62d399">
        <text class="section-title data-v-bf62d399">等级体系</text>
        <view class="level-list data-v-bf62d399">
          <view wx:for="{{levelRows}}" wx:key="key" class="level-row data-v-bf62d399">
            <view class="level-dot data-v-bf62d399" style="background: {{item.color}}" />
            <view class="level-body data-v-bf62d399">
              <text class="level-name data-v-bf62d399">{{item.title}}</text>
              <text class="level-require data-v-bf62d399">累计消费满 {{item.spentRequiredText}} {{item.actionText}}</text>
            </view>
            <text wx:if="{{item.isCurrent}}" class="level-badge data-v-bf62d399">当前</text>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="loading-wrap data-v-bf62d399"><text class="data-v-bf62d399">{{errorMessage}}</text></view>
    <view class="safe-bottom data-v-bf62d399" />
  </view>
</view>
