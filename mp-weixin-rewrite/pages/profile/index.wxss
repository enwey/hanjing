.profile-page {
  min-height: 100vh;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx 32rpx 0;
}

.user-card {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  padding: 40rpx;
  border-radius: 32rpx;
  background: #ffffff;
}

.user-avatar {
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  background: linear-gradient(135deg, #3b6bf5, #8eafff);
}

.user-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
  inset: 0;
}

.user-avatar-image {
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
  inset: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  margin-bottom: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.user-level-tag {
  display: inline-flex;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #fff9e6;
  font-size: 24rpx;
  font-weight: 500;
  color: #f5a623;
}

.user-arrow {
  font-size: 48rpx;
  color: #d1d5db;
}

.profile-setup-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7e8 0%, #fffaf2 100%);
  border: 1rpx solid rgba(243, 155, 26, 0.18);
}

.profile-setup-card__body {
  flex: 1;
}

.profile-setup-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #7c4a03;
}

.profile-setup-card__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #9a6a27;
}

.profile-setup-card__action {
  padding: 14rpx 24rpx;
  border-radius: 9999rpx;
  background: #f39b1a;
  font-size: 24rpx;
  font-weight: 600;
  color: #ffffff;
  flex-shrink: 0;
}

.menu-group {
  margin-bottom: 16rpx;
}

.menu-group-title {
  display: block;
  padding: 16rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #9ca3af;
}

.menu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: #ffffff;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.menu-item:not(:last-child) {
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.menu-icon--distribution {
  width: 42rpx;
  height: 42rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  margin-right: 16rpx;
  border-radius: 9999rpx;
  background: #ef4444;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  box-sizing: border-box;
  flex-shrink: 0;
}

.menu-arrow {
  font-size: 40rpx;
  color: #d1d5db;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
