<view class="page">
  <hj-navbar title="阻鼾器管理" show-back></hj-navbar>

  <view class="page-content">
    <picker wx:if="{{memberOptions.length}}" mode="selector" range="{{memberOptions}}" value="{{memberIndex}}" bindchange="onMemberChange" class="member-picker">
      <view class="member-picker-content">
        <view class="member-info">
          <text class="member-label">当前就诊人：</text>
          <text class="member-value">{{memberOptions[memberIndex]}}</text>
        </view>
        <view class="member-action">
          <text class="member-action-text">切换</text>
          <image class="member-action-arrow" src="/static/icons/chevron-right.svg" mode="aspectFit"></image>
        </view>
      </view>
    </picker>

    <view wx:if="{{loading}}" class="state-wrap">
      <text class="state-text">加载中...</text>
    </view>

    <block wx:else>
      <view wx:if="{{device}}" class="device-card">
        <view class="device-card__header">
          <view>
            <text class="device-card__title">{{device.name}}</text>
            <text class="device-card__subtitle">{{device.model}}</text>
          </view>
          <view class="device-status {{device.status === 'active' ? 'active' : ''}}">
            <text>{{device.status === 'active' ? '使用中' : '待维护'}}</text>
          </view>
        </view>
        <view class="device-grid">
          <view class="device-grid__item">
            <text class="device-grid__label">设备编号</text>
            <text class="device-grid__value">{{device.serialNumber || '-'}}</text>
          </view>
          <view class="device-grid__item">
            <text class="device-grid__label">佩戴天数</text>
            <text class="device-grid__value">{{device.wearDays || 0}} 天</text>
          </view>
          <view class="device-grid__item">
            <text class="device-grid__label">上次维护</text>
            <text class="device-grid__value">{{device.lastMaintenance || '暂无记录'}}</text>
          </view>
          <view class="device-grid__item">
            <text class="device-grid__label">推荐复诊</text>
            <text class="device-grid__value">{{device.nextFollowup || '待安排'}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{!device}}" class="state-wrap">
        <text class="state-text">当前就诊人暂无关联设备</text>
      </view>

      <view class="menu-card">
        <view wx:for="{{menuItems}}" wx:key="key" class="menu-item" data-url="{{item.url}}" bindtap="goMenu">
          <view class="menu-item__icon-wrap">
            <image class="menu-item__icon" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view class="menu-item__content">
            <text class="menu-item__title">{{item.label}}</text>
            <text class="menu-item__desc">{{item.desc}}</text>
          </view>
          <image class="menu-item__arrow" src="/static/icons/chevron-right.svg" mode="aspectFit"></image>
        </view>
      </view>
    </block>

    <view class="safe-bottom"></view>
  </view>
</view>
