<view class="page data-v-ecc58349">
  <hj-navbar title="账号安全" showBack="{{true}}" />
  <view class="page-content data-v-ecc58349">
    <view wx:if="{{loading}}" class="loading-wrap data-v-ecc58349"><text class="data-v-ecc58349">加载中...</text></view>
    <block wx:elif="{{info}}">
      <view class="info-group data-v-ecc58349">
        <view class="info-row data-v-ecc58349" bindtap="openPhoneModal">
          <text class="info-label data-v-ecc58349">绑定手机</text>
          <text class="info-val data-v-ecc58349" style="color: #3B6BF5;">{{info.phone}} ✎</text>
        </view>
        <view class="info-row data-v-ecc58349">
          <text class="info-label data-v-ecc58349">登录密码</text>
          <text class="info-val data-v-ecc58349">{{info.hasPassword ? '已设置' : '未设置'}}</text>
        </view>
        <view class="info-row data-v-ecc58349" bindtap="openRealnameModal">
          <text class="info-label data-v-ecc58349">实名认证</text>
          <text class="info-val success data-v-ecc58349" style="color: #3B6BF5;">{{info.realNameVerified ? ('已认证（' + info.realName + '）') : '点击去认证'}} ✎</text>
        </view>
      </view>
    </block>

    <view wx:if="{{showPhoneModal}}" class="modal-overlay data-v-ecc58349" bindtap="closePhoneModal" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:999; display:flex; align-items:center; justify-content:center;">
      <view class="modal-card data-v-ecc58349" catchtap="noop" style="background:#fff; border-radius:16rpx; padding:40rpx; width:80%; box-sizing:border-box;">
        <view class="modal-header data-v-ecc58349" style="font-size:32rpx; font-weight:bold; text-align:center; margin-bottom:30rpx; color:#1f2937;">更换绑定手机</view>
        <view class="modal-body data-v-ecc58349" style="display:flex; flex-direction:column; gap:24rpx; margin-bottom:40rpx;">
          <view class="modal-tip data-v-ecc58349">请通过微信手机号授权完成重新绑定。</view>
        </view>
        <view class="modal-actions data-v-ecc58349" style="display:flex; gap:20rpx;">
          <button bindtap="closePhoneModal" style="flex:1; background:#f3f4f6; color:#4b5563; font-size:28rpx; border:none; border-radius:8rpx; height:80rpx; line-height:80rpx;">取消</button>
          <button
            wx:if="{{isDevTools}}"
            bindtap="onDeveloperChangePhone"
            style="flex:1; background:#3B6BF5; color:#fff; font-size:28rpx; border:none; border-radius:8rpx; height:80rpx; line-height:80rpx;"
          >微信手机号换绑</button>
          <button
            wx:else
            open-type="getPhoneNumber"
            bindgetphonenumber="onChangePhoneByWechat"
            style="flex:1; background:#3B6BF5; color:#fff; font-size:28rpx; border:none; border-radius:8rpx; height:80rpx; line-height:80rpx;"
          >微信手机号换绑</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showRealnameModal}}" class="modal-overlay data-v-ecc58349" bindtap="closeRealnameModal" style="position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:999; display:flex; align-items:center; justify-content:center;">
      <view class="modal-card data-v-ecc58349" catchtap="noop" style="background:#fff; border-radius:16rpx; padding:40rpx; width:80%; box-sizing:border-box;">
        <view class="modal-header data-v-ecc58349" style="font-size:32rpx; font-weight:bold; text-align:center; margin-bottom:30rpx; color:#1f2937;">实名认证</view>
        <view class="modal-body data-v-ecc58349" style="display:flex; flex-direction:column; gap:24rpx; margin-bottom:40rpx;">
          <view class="form-field data-v-ecc58349">
            <input class="form-input data-v-ecc58349" placeholder="请输入真实姓名" value="{{inputRealName}}" bindinput="handleRealNameInput" />
          </view>
          <view class="form-field data-v-ecc58349">
            <input class="form-input data-v-ecc58349" placeholder="请输入18位身份证号" maxlength="18" value="{{inputIdCard}}" bindinput="handleIdCardInput" />
          </view>
        </view>
        <view class="modal-actions data-v-ecc58349" style="display:flex; gap:20rpx;">
          <button bindtap="closeRealnameModal" style="flex:1; background:#f3f4f6; color:#4b5563; font-size:28rpx; border:none; border-radius:8rpx; height:80rpx; line-height:80rpx;">取消</button>
          <button bindtap="onSubmitRealname" style="flex:1; background:#3B6BF5; color:#fff; font-size:28rpx; border:none; border-radius:8rpx; height:80rpx; line-height:80rpx;">立即认证</button>
        </view>
      </view>
    </view>
    <view class="safe-bottom data-v-ecc58349" />
  </view>
</view>
