<view class="page profile-page">
  <hj-navbar title="我的" />

  <view class="page-content">
    <view class="user-card" bindtap="handleProfileTap">
      <view class="user-avatar">
        <image class="user-avatar-placeholder" src="/static/images/brand-koala.png" mode="aspectFill" />
        <image wx:if="{{avatarUrl}}" class="user-avatar-image" src="{{avatarUrl}}" mode="aspectFill" />
      </view>
      <view class="user-info">
        <text class="user-name">{{nickname}}</text>
        <view class="user-level">
          <text class="user-level-tag">{{memberLevelLabel}}</text>
        </view>
      </view>
      <text class="user-arrow">›</text>
    </view>

    <view wx:if="{{showProfileSetupCard}}" class="profile-setup-card">
      <view class="profile-setup-card__body">
        <text class="profile-setup-card__title">完善资料</text>
        <text class="profile-setup-card__desc">完善资料，有助于更好地保存个人信息与使用记录。</text>
      </view>
      <view class="profile-setup-card__action" bindtap="handleCompleteProfile">去完善</view>
    </view>

    <view wx:for="{{menuGroups}}" wx:key="title" class="menu-group">
      <text class="menu-group-title">{{item.title}}</text>
      <view class="menu-list">
        <view
          wx:for="{{item.items}}"
          wx:key="key"
          class="menu-item"
          data-url="{{item.url}}"
          bindtap="openEntry"
        >
          <image class="menu-icon {{item.key === 'distribution' ? 'menu-icon--distribution' : ''}}" src="{{item.icon}}" />
          <text class="menu-label">{{item.label}}</text>
          <view
            wx:if="{{(item.key === 'service' && serviceUnreadCount > 0) || (item.key === 'notifications' && notificationsUnreadCount > 0)}}"
            class="menu-badge"
          >{{item.key === 'service' ? (serviceUnreadCount > 99 ? '99+' : serviceUnreadCount) : (notificationsUnreadCount > 99 ? '99+' : notificationsUnreadCount)}}</view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
