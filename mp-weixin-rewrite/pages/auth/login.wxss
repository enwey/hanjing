.login-page {
  min-height: calc(100vh - 88px);
  box-sizing: border-box;
  padding: 80rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-section {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.logo-container {
  width: 176rpx;
  height: 176rpx;
  margin-bottom: 40rpx;
  border-radius: 50%;
  background: rgba(59, 107, 245, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo-image {
  width: 100%;
  height: 100%;
  display: block;
}

.brand-name {
  margin-bottom: 16rpx;
  font-size: 48rpx;
  font-weight: 700;
  color: #1a3580;
}

.brand-slogan {
  font-size: 26rpx;
  color: #6b7280;
}

.auth-section {
  width: 100%;
  margin-top: 100rpx;
  margin-bottom: auto;
}

.auth-tip-card {
  margin-bottom: 48rpx;
  padding: 32rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 32rpx;
  background: #f9fafb;
}

.tip-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.tip-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #6b7280;
}

.env-switcher-card {
  margin-bottom: 40rpx;
  padding: 28rpx 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #f8fafc 0%, #eef4ff 100%);
  border: 1rpx solid rgba(59, 107, 245, 0.14);
  box-shadow: 0 10rpx 24rpx rgba(59, 107, 245, 0.08);
}

.env-switcher-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.env-switcher-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.env-switcher-action {
  font-size: 24rpx;
  color: #3b6bf5;
}

.env-switcher-current {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a3580;
}

.env-switcher-url {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #64748b;
  word-break: break-all;
}

.auth-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  margin-bottom: 32rpx;
  border: none;
  border-radius: 24rpx;
  background: #07c160;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.25);
  text-align: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.cancel-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  margin-bottom: 40rpx;
  border: none;
  border-radius: 24rpx;
  background: #f3f4f6;
  text-align: center;
  color: #4b5563;
  font-size: 32rpx;
  font-weight: 600;
}

.password-entry {
  padding: 8rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #3b6bf5;
}

.password-login-card {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.password-login-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.password-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.45);
}

.password-modal-card {
  width: 100%;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.password-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.password-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.password-modal-cancel {
  font-size: 26rpx;
  color: #94a3b8;
}

.password-login-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.password-login-back {
  font-size: 24rpx;
  color: #3b6bf5;
}

.password-login-input {
  width: 100%;
  height: 92rpx;
  margin-bottom: 20rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #1f2937;
}

.password-login-hint {
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  color: #6b7280;
}

.password-modal-btn {
  margin-top: 28rpx;
  margin-bottom: 0;
}

.cancel-btn::after,
.auth-btn::after {
  border: none;
}

.protocol-section {
  margin-top: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #9ca3af;
}

.protocol-label {
  display: flex;
  align-items: center;
}

.protocol-checkbox {
  transform: scale(0.65);
  margin-right: -4rpx;
}

.protocol-text {
  color: #9ca3af;
}

.protocol-link {
  color: #3b6bf5;
  display: inline;
}
