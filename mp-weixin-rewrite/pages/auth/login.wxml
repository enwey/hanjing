<view class="page-container">
  <hj-navbar title="{{copy.navTitle}}" />
  <view class="page-content login-page">
    <view class="brand-section">
      <text class="brand-name">{{copy.brandName}}</text>
      <text class="brand-slogan">{{copy.brandSlogan}}</text>
    </view>

    <view class="auth-section">
      <view class="auth-tip-card">
        <view class="tip-header">
          <text class="tip-icon">{{copy.lockIcon}}</text>
          <text class="tip-title">{{copy.tipTitle}}</text>
        </view>
        <text class="tip-content">{{copy.tipContent}}</text>
      </view>

      <button
        wx:if="{{agreed}}"
        class="auth-btn"
        open-type="getPhoneNumber"
        bindtap="onLoginTap"
        bindgetphonenumber="onGetPhoneNumber"
        binderror="onLoginOpenTypeError"
      >
        {{copy.loginButton}}
      </button>
      <button
        wx:else
        class="auth-btn"
        bindtap="onLoginTap"
      >
        {{copy.loginButton}}
      </button>
    </view>

    <view class="protocol-section">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="protocol-label">
          <checkbox class="protocol-checkbox" value="agree" checked="{{agreed}}" color="#3b6bf5" />
          <text class="protocol-text">{{copy.protocolPrefix}}</text>
        </label>
      </checkbox-group>
      <text class="protocol-link" bindtap="viewAgreement">{{copy.userAgreement}}</text>
      <text class="protocol-text">{{copy.andText}}</text>
      <text class="protocol-link" bindtap="viewPrivacy">{{copy.privacyPolicy}}</text>
    </view>
  </view>
  <hj-privacy-popup id="privacyPopup" />
</view>
