<view class="page-container">
  <hj-navbar title="{{copy.navTitle}}" showBack="{{true}}" customBack="{{true}}" bind:back="handleBack" />
  <view class="page-content login-page">
    <view class="brand-section">
      <view class="logo-container">
        <image class="logo-image" src="/static/images/brand-logo.png" mode="aspectFit" />
      </view>
      <text class="brand-name">{{copy.brandName}}</text>
      <text class="brand-slogan">{{copy.brandSlogan}}</text>
    </view>

    <view class="auth-section">
      <view class="auth-tip-card">
        <view class="tip-header">
          <text class="tip-icon">{{copy.lockIcon}}</text>
          <text class="tip-title">{{copy.tipTitle}}</text>
        </view>
        <text class="tip-content">{{copy.tipContent}}</text>
      </view>

      <view wx:if="{{showEnvSwitcher}}" class="env-switcher-card" bindtap="handleApiEnvSwitch">
        <view class="env-switcher-header">
          <text class="env-switcher-title">{{copy.envSwitcherTitle}}</text>
          <text class="env-switcher-action">点击切换</text>
        </view>
        <text class="env-switcher-current">{{currentApiEnvLabel}}</text>
        <text class="env-switcher-url">{{currentApiBaseUrl}}</text>
      </view>

      <button
        wx:if="{{showLocalLogin}}"
        class="auth-btn"
        disabled="{{submitting}}"
        loading="{{submitting}}"
        bindtap="onLocalLogin"
      >本地模拟登录</button>
      <button
        wx:elif="{{agreed}}"
        class="auth-btn"
        open-type="getPhoneNumber"
        disabled="{{submitting}}"
        bindtap="onLoginTap"
        bindgetphonenumber="onGetPhoneNumber"
        binderror="onLoginOpenTypeError"
      >
        {{copy.loginButton}}
      </button>
      <button
        wx:else
        class="auth-btn"
        disabled="{{submitting}}"
        bindtap="onAgreementRequiredTap"
      >
        {{copy.loginButton}}
      </button>
    </view>

    <view class="protocol-section">
      <checkbox-group bindchange="handleAgreementChange">
        <label class="protocol-label">
          <checkbox class="protocol-checkbox" value="agree" checked="{{agreed}}" color="#3b6bf5" />
          <text class="protocol-text">{{copy.protocolPrefix}}</text>
        </label>
      </checkbox-group>
      <text class="protocol-link" bindtap="viewAgreement">{{copy.userAgreement}}</text>
      <text class="protocol-text">{{copy.andText}}</text>
      <text class="protocol-link" bindtap="viewPrivacy">{{copy.privacyPolicy}}</text>
    </view>
  </view>
  <hj-privacy-popup id="privacyPopup" />
</view>
