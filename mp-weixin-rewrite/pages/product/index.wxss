.product-page {
  min-height: 100vh;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 0 24rpx;
}

.category-tabs-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  background: transparent;
  padding: 20rpx 0;
}

.category-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
}

.category-tabs-placeholder {
  height: 104rpx;
}

.category-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.category-tab__text {
  font-size: 26rpx;
  color: #6b7280;
}

.category-tab--active {
  background: #3b6bf5;
}

.category-tab--active .category-tab__text {
  color: #ffffff;
  font-weight: 600;
}

.waterfall-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  width: 100%;
  margin-top: 20rpx;
}

.waterfall-column {
  width: calc(50% - 10rpx);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-card {
  width: 100%;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.product-card__cover {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: #f3f4f6;
}

.product-card__cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-card__discount {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #ef4444;
}

.product-card__discount text {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

.product-card__body {
  padding: 24rpx;
}

.product-card__name {
  display: -webkit-box;
  overflow: hidden;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #1f2937;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-card__footer {
  display: flex;
  flex-direction: column;
}

.product-card__price-sales-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.product-card__price-original-row {
  display: flex;
  margin-top: 0;
}

.product-card__price {
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 700;
  color: #ef4444;
}

.product-card__original-price {
  font-size: 24rpx;
  line-height: 1.2;
  text-decoration: line-through;
  color: #9ca3af;
}

.product-card__sales {
  font-size: 22rpx;
  color: #9ca3af;
}

.state-card {
  padding: 120rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
