<view class="page">
  <view class="hero">
    <hj-navbar title="" textColor="#FFFFFF" backgroundColor="transparent" transparent="{{true}}" sticky="{{false}}" />
    <view class="hero-navbar-spacer"></view>
    <view class="hero-content">
      <text class="hero-title">鼾静健康</text>
      <text class="hero-subtitle">睡眠自测、打卡追踪与健康知识</text>
      <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-stat-num">{{patientCountLabel}}</text>
        <text class="hero-stat-label">累计用户</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-num">{{satisfactionRateLabel}}</text>
        <text class="hero-stat-label">满意率</text>
      </view>
    </view>
  </view>
</view>

  <view class="section quick-actions">
    <view class="quick-action" bindtap="goEssAssessment">
      <image class="quick-action-icon quick-action-icon--assessment" src="/static/icons/assessment_purple.svg" />
      <text class="quick-action-text">嗜睡量表</text>
    </view>
    <view class="quick-action" bindtap="goSnoreAssessment">
      <image class="quick-action-icon quick-action-icon--assessment" src="/static/icons/microphone.svg" />
      <text class="quick-action-text">鼾声分析</text>
    </view>
    <view class="quick-action" bindtap="goTreatmentTab">
      <image class="quick-action-icon quick-action-icon--treatment" src="/static/icons/treatment_green.svg" />
      <text class="quick-action-text">打卡追踪</text>
    </view>
  </view>

  <view class="section" wx:if="{{loadError}}">
    <text class="state-text">{{loadError}}</text>
  </view>

  <view class="section">
    <view class="section-header">
      <text class="section-title">睡眠文章</text>
    </view>
    <view class="article-list">
      <view wx:for="{{articleCards}}" wx:key="id" class="article-card" data-article-id="{{item.id}}" bindtap="openArticleDetail">
        <view class="article-body">
          <view class="article-meta-row">
            <view class="article-icon article-icon--{{item.theme}}">
              <image class="article-icon__image" src="{{item.icon}}" mode="aspectFit"></image>
            </view>
            <text class="article-category">{{item.category}}</text>
            <text class="article-dot">·</text>
            <text class="article-source">{{item.source}}</text>
            <block wx:if="{{item.timeText}}">
              <text class="article-dot">·</text>
              <text class="article-time">{{item.timeText}}</text>
            </block>
          </view>
          <text class="article-title">{{item.title}}</text>
          <text class="article-desc">{{item.summary}}</text>
          <view class="article-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="article-tag">{{item}}</text>
          </view>
        </view>
        <view class="article-more-arrow"></view>
      </view>
    </view>
  </view>

  <view class="safe-bottom" />
  <hj-privacy-popup id="privacyPopup" />
</view>
