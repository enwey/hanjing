.page {
  min-height: 100vh;
  background: #f9fafb;
}

.hero {
  background: linear-gradient(160deg, #1a3580, #3b6bf5 40%, #8eafff);
  padding-bottom: 80rpx;
  position: relative;
  overflow: hidden;
}

.hero-navbar-spacer {
  height: calc(env(safe-area-inset-top) + 26px);
}

.hero::after {
  content: "";
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  top: -200rpx;
  right: -200rpx;
  border-radius: 50%;
}

.hero-content {
  padding: 10px 16px 0;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 30px;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8px;
  margin-left: 12px;
}

.hero-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 24px;
  margin-left: 12px;
}

.hero-stats {
  display: flex;
  gap: 24px;
  margin-bottom: 28px;
  margin-left: 12px;
}

.hero-stat {
  display: flex;
  flex-direction: column;
}

.hero-stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
}

.hero-stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2px;
}

.hero-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 52px;
  background: #ffffff;
  color: #3b6bf5;
  font-size: 17px;
  font-weight: 700;
  border-radius: 16px;
  border: none;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.hero-btn::after {
  border: none;
}

.hero-btn-text {
  display: block;
  line-height: 22px;
}

.hero-btn-arrow {
  display: block;
  width: 18px;
  height: 18px;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  margin: -20px 16px 16px;
  border-radius: 16px;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section.quick-actions {
  padding: 14px 16px;
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.quick-action-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  box-sizing: border-box;
  padding: 11px;
}

.quick-action-icon--appointment {
  background: #eef4ff;
}

.quick-action-icon--assessment {
  background: #f5f3ff;
}

.quick-action-icon--treatment {
  background: #eaf8f1;
}

.quick-action-icon--profile {
  background: #fffbeb;
}

.quick-action-text {
  font-size: 12px;
  color: #4b5563;
  font-weight: 500;
}

.section {
  padding: 0 16px;
  margin-bottom: 8px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0 12px;
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  color: #1f2937;
}

.section-more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  gap: 4rpx;
  font-size: 14px;
  color: #3b6bf5;
}

.section-more-text {
  display: block;
  line-height: 20px;
}

.section-more-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 20px;
  color: inherit;
}

.section-more-arrow::after {
  content: "";
  width: 5px;
  height: 5px;
  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.state-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6b7280;
  padding: 16rpx 0;
}

.state-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.article-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.article-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.article-icon--purple {
  background: #f5f3ff;
}

.article-icon--blue {
  background: #eef4ff;
}

.article-icon--green {
  background: #eaf8f1;
}

.article-icon--amber {
  background: #fffbeb;
}

.article-icon__image {
  width: 26rpx;
  height: 26rpx;
}

.article-body {
  flex: 1;
  min-width: 0;
}

.article-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.article-category {
  font-size: 22rpx;
  font-weight: 700;
  color: #3b6bf5;
}

.article-source,
.article-time,
.article-dot {
  font-size: 22rpx;
  color: #9ca3af;
}

.article-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #1f2937;
}

.article-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.article-tag {
  font-size: 20rpx;
  color: #3b6bf5;
  background: #eef4ff;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.article-more-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid #cbd5e1;
  border-right: 2rpx solid #cbd5e1;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
