.page {
  min-height: 100vh;
  background: #f9fafb;
}

.hero {
  background: linear-gradient(160deg, #1a3580, #3b6bf5 40%, #8eafff);
  padding-bottom: 80rpx;
  position: relative;
  overflow: hidden;
}

.hero-navbar-spacer {
  height: calc(env(safe-area-inset-top) + 26px);
}

.hero::after {
  content: "";
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  top: -200rpx;
  right: -200rpx;
  border-radius: 50%;
}

.hero-content {
  padding: 10px 16px 0;
  position: relative;
  z-index: 1;
}

.hero-title {
  font-size: 30px;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 8px;
  margin-left: 12px;
}

.hero-subtitle {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 24px;
  margin-left: 12px;
}

.hero-stats {
  display: flex;
  gap: 24px;
  margin-bottom: 28px;
  margin-left: 12px;
}

.hero-stat {
  display: flex;
  flex-direction: column;
}

.hero-stat-num {
  font-size: 22px;
  font-weight: 700;
  color: #ffffff;
}

.hero-stat-label {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2px;
}

.hero-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 52px;
  background: #ffffff;
  color: #3b6bf5;
  font-size: 17px;
  font-weight: 700;
  border-radius: 16px;
  border: none;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
}

.hero-btn::after {
  border: none;
}

.hero-btn-text {
  display: block;
  line-height: 22px;
}

.hero-btn-arrow {
  display: block;
  width: 18px;
  height: 18px;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  margin: -20px 16px 16px;
  border-radius: 16px;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.section.quick-actions {
  padding: 14px 16px;
}

.quick-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.quick-action-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  box-sizing: border-box;
  padding: 11px;
}

.quick-action-icon--appointment {
  background: #eef4ff;
}

.quick-action-icon--assessment {
  background: #f5f3ff;
}

.quick-action-icon--treatment {
  background: #eaf8f1;
}

.quick-action-icon--profile {
  background: #fffbeb;
}

.quick-action-text {
  font-size: 12px;
  color: #4b5563;
  font-weight: 500;
}

.section {
  padding: 0 16px;
  margin-bottom: 8px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0 12px;
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  color: #1f2937;
}

.section-more {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  gap: 4rpx;
  font-size: 14px;
  color: #3b6bf5;
}

.section-more-text {
  display: block;
  line-height: 20px;
}

.section-more-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 12px;
  height: 20px;
  color: inherit;
}

.section-more-arrow::after {
  content: "";
  width: 5px;
  height: 5px;
  border-top: 1px solid currentColor;
  border-right: 1px solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.state-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6b7280;
  padding: 16rpx 0;
}

.state-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.community-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.community-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.community-tab--active {
  background: #3b6bf5;
  color: #ffffff;
  font-weight: 600;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.post-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.post-top {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #fff9e6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.post-top__icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
}

.post-top__text {
  font-size: 22rpx;
  color: #f5a623;
  font-weight: 600;
}

.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 9999rpx;
  background: #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}

.post-avatar__placeholder {
  width: 100%;
  height: 100%;
  display: block;
  position: absolute;
  inset: 0;
}

.post-avatar__image {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
  opacity: 0;
}

.post-avatar__image--loaded {
  opacity: 1;
}

.post-author {
  flex: 1;
  min-width: 0;
}

.post-author__row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.post-author__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.post-author__role {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.post-author__role.role--doctor {
  background: #eef4ff;
  color: #3b6bf5;
}

.post-author__role.role--expert {
  background: #f5f3ff;
  color: #8b5cf6;
}

.post-author__role.role--patient {
  background: #f0fdf4;
  color: #1a9d5c;
}

.post-author__time {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 4rpx;
}

.post-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.post-content {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.75;
  display: block;
  margin-bottom: 12rpx;
}

.post-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 14rpx;
}

.post-category,
.post-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.post-tag {
  color: #3b6bf5;
  background: #eef4ff;
}

.tag-theme--blue {
  color: #2a52d4;
  background: #e8f0ff;
}

.tag-theme--green {
  color: #138a52;
  background: #e8f8ef;
}

.tag-theme--orange {
  color: #d97706;
  background: #fff3df;
}

.tag-theme--amber {
  color: #b7791f;
  background: #fff8db;
}

.tag-theme--pink {
  color: #c2417a;
  background: #ffe8f1;
}

.tag-theme--violet {
  color: #6d4fd6;
  background: #f0ebff;
}

.post-actions {
  display: flex;
  gap: 28rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f4f6;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.post-action__icon {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.post-action__icon.liked {
  transform: scale(1.04);
}

.post-action__count {
  font-size: 22rpx;
  color: #9ca3af;
}

.publish-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom, 0));
  z-index: 20;
  width: 104rpx;
  height: 104rpx;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #3b6bf5, #5a85f5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(59, 107, 245, 0.35);
}

.publish-fab__icon {
  width: 42rpx;
  height: 42rpx;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
