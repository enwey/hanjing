.order-page {
  min-height: 100vh;
  background: #f9fafb;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 0 24rpx;
}

.order-tabs-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 20;
  background: transparent;
  padding: 20rpx 0;
}

.order-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
}

.order-tabs-placeholder {
  height: 104rpx;
}

.order-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.order-tab__text {
  font-size: 26rpx;
  color: #6b7280;
}

.order-tab--active {
  background: #3b6bf5;
}

.order-tab--active .order-tab__text {
  color: #ffffff;
  font-weight: 600;
}

.state-card {
  padding: 160rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.order-list {
  padding: 0 8rpx;
  margin-top: 24rpx;
}

.order-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
}

.order-card__header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.order-card__number {
  font-size: 26rpx;
  color: #9ca3af;
}

.order-card__status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.order-item__cover-image,
.order-item__placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  flex-shrink: 0;
}

.order-item__placeholder {
  background: #eef4ff;
}

.order-item__body {
  flex: 1;
  min-width: 0;
}

.order-item__name {
  display: block;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.order-item__count {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.order-item__price {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.order-card__footer {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.order-card__count {
  font-size: 26rpx;
  color: #6b7280;
}

.order-card__amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #ef4444;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
