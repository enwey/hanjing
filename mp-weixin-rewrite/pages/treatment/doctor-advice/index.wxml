<view class="page data-v-3fe7702c">
  <hj-navbar title="医嘱建议" showBack="{{true}}" />
  <view class="page-content data-v-3fe7702c">
    <block wx:if="{{hasRealTreatmentRecord}}">
      <view wx:for="{{adviceSections}}" wx:key="key" class="card data-v-3fe7702c {{item.highlight ? 'card--highlight' : ''}}">
        <text class="card-title data-v-3fe7702c">{{item.title}}</text>
        <text class="card-text data-v-3fe7702c">{{item.content}}</text>
      </view>
      <view wx:if="{{!adviceSections.length}}" class="empty-section data-v-3fe7702c"><text class="empty-section-text data-v-3fe7702c">医生暂未同步本次诊疗的医嘱内容，请在复诊后回来查看。</text></view>
      <view wx:if="{{followupDate}}" class="card card--followup data-v-3fe7702c">
        <text class="card-title data-v-3fe7702c">下次随访</text>
        <text class="followup-date data-v-3fe7702c">{{followupDate}}</text>
        <text class="followup-hint data-v-3fe7702c">请按时复诊，医生将评估治疗效果并调整参数</text>
      </view>
      <view class="btn-wrap data-v-3fe7702c"><button class="book-btn data-v-3fe7702c" bindtap="goAppointment">预约复诊</button></view>
    </block>
    <view wx:elif="{{loading || loadError}}" class="empty-card data-v-3fe7702c"><text class="empty-desc data-v-3fe7702c">{{loading ? '正在加载医嘱建议...' : loadError}}</text></view>
    <view wx:else class="empty-card data-v-3fe7702c">
      <text class="empty-title data-v-3fe7702c">暂无治疗记录</text>
      <text class="empty-desc data-v-3fe7702c">当前治疗人还没有完成门诊建档或阻鼾器适配，暂时无法查看医嘱建议。完成预约就诊后，医生建议会同步展示在这里。</text>
      <button class="book-btn data-v-3fe7702c" bindtap="goAppointment">前往预约</button>
    </view>
    <view class="safe-bottom data-v-3fe7702c"></view>
  </view>
</view>
