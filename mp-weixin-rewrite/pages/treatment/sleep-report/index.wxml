<view class="page data-v-72813ef9">
  <hj-navbar title="睡眠报告" showBack="{{true}}" />
  <view class="page-content data-v-72813ef9">
    <view class="period-switch data-v-72813ef9">
      <view class="period-btn data-v-72813ef9 {{selectedRange === 'week' ? 'active' : ''}}" data-range="week" bindtap="selectDateRange">过去7天</view>
      <view class="period-btn data-v-72813ef9 {{selectedRange === 'month' ? 'active' : ''}}" data-range="month" bindtap="selectDateRange">过去30天</view>
    </view>
    <view wx:if="{{loading}}" class="empty-card data-v-72813ef9"><text class="empty-desc data-v-72813ef9">正在生成睡眠健康报告...</text></view>
    <view wx:elif="{{loadError}}" class="empty-card data-v-72813ef9"><text class="empty-desc data-v-72813ef9">{{loadError}}</text></view>
    <block wx:elif="{{report && report.hasData}}">
      <view class="score-card data-v-72813ef9" style="background: {{report.scoreCardBg}}">
        <view class="score-ring data-v-72813ef9">
          <text class="score-num data-v-72813ef9">{{report.score}}</text>
          <text class="score-unit data-v-72813ef9">分</text>
        </view>
        <view class="score-info data-v-72813ef9">
          <text class="score-level data-v-72813ef9">{{report.scoreLevel}}</text>
          <text class="score-period data-v-72813ef9">{{report.patientLabel}} · {{report.rangeLabel}}</text>
        </view>
        <view class="score-bar-wrap data-v-72813ef9"><view class="score-bar data-v-72813ef9" style="width: {{report.score}}%; background: {{report.scoreBarColor}}"></view></view>
      </view>
      <text class="section-title data-v-72813ef9">核心指标</text>
      <view class="metrics-grid data-v-72813ef9">
        <view class="metric-card data-v-72813ef9"><text class="metric-val data-v-72813ef9">{{report.weekAvg}}h</text><text class="metric-label data-v-72813ef9">平均时长</text><view class="metric-bar data-v-72813ef9"><view class="metric-fill green data-v-72813ef9" style="width: {{report.weekAvgWidth}}"></view></view></view>
        <view class="metric-card data-v-72813ef9"><text class="metric-val data-v-72813ef9">{{report.compliance}}%</text><text class="metric-label data-v-72813ef9">依从率</text><view class="metric-bar data-v-72813ef9"><view class="metric-fill blue data-v-72813ef9" style="width: {{report.complianceWidth}}"></view></view></view>
        <view class="metric-card data-v-72813ef9"><text class="metric-val data-v-72813ef9">{{report.avgComfort}}</text><text class="metric-label data-v-72813ef9">舒适度</text><view class="metric-bar data-v-72813ef9"><view class="metric-fill orange data-v-72813ef9" style="width: {{report.avgComfortWidth}}"></view></view></view>
        <view class="metric-card data-v-72813ef9"><text class="metric-val data-v-72813ef9">{{report.streak}}</text><text class="metric-label data-v-72813ef9">连续天数</text><view class="metric-bar data-v-72813ef9"><view class="metric-fill blue data-v-72813ef9" style="width: {{report.streakWidth}}"></view></view></view>
      </view>
      <text class="section-title data-v-72813ef9">趋势分布</text>
      <view class="trend-chart data-v-72813ef9">
        <view class="trend-bars data-v-72813ef9">
          <view wx:for="{{report.trend}}" wx:key="date" class="trend-bar data-v-72813ef9" style="height: {{item.scoreHeight}}; background: {{item.scoreColor}}"></view>
        </view>
        <view class="trend-labels data-v-72813ef9"><text wx:for="{{report.trend}}" wx:key="date" class="trend-label data-v-72813ef9">{{item.date}}</text></view>
      </view>
      <text class="section-title data-v-72813ef9">报告建议</text>
      <view wx:for="{{insights}}" wx:key="id" class="peer-card data-v-72813ef9">
        <view class="peer-header data-v-72813ef9"><text class="peer-title data-v-72813ef9">{{item.title}}</text></view>
        <view class="peer-row data-v-72813ef9"><text class="peer-label data-v-72813ef9">{{item.text}}</text></view>
      </view>
    </block>
    <view wx:else class="empty-card data-v-72813ef9">
      <text class="empty-title data-v-72813ef9">暂无睡眠报告</text>
      <text class="empty-desc data-v-72813ef9">当前还没有可展示的睡眠报告数据。</text>
    </view>
    <view class="safe-bottom data-v-72813ef9"></view>
  </view>
</view>
