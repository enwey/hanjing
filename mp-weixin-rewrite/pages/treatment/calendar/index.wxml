<view class="page data-v-c9f86960">
  <hj-navbar title="打卡日历" showBack="{{true}}" />
  <view class="page-content data-v-c9f86960">
    <view class="month-bar data-v-c9f86960">
      <view class="month-nav data-v-c9f86960" bindtap="goPrevMonth"><text class="nav-arrow data-v-c9f86960">◀</text>上月</view>
      <text class="month-title data-v-c9f86960">{{monthText}}</text>
      <view class="month-nav data-v-c9f86960" bindtap="goNextMonth">下月<text class="nav-arrow data-v-c9f86960">▶</text></view>
    </view>
    <view class="calendar-card data-v-c9f86960">
      <view class="week-row data-v-c9f86960">
        <text wx:for="{{weekLabels}}" wx:key="*this" class="week-label data-v-c9f86960">{{item}}</text>
      </view>
      <view class="calendar-grid data-v-c9f86960">
        <view wx:for="{{dayCells}}" wx:key="id" class="calendar-day data-v-c9f86960 {{item.dayClass}} {{item.isEmpty ? 'calendar-day--empty' : ''}}">
          <block wx:if="{{!item.isEmpty}}">
            <text class="calendar-day-num data-v-c9f86960">{{item.day}}</text>
            <text wx:if="{{item.wearDurationLabel}}" class="calendar-day-duration data-v-c9f86960">{{item.wearDurationLabel}}</text>
          </block>
        </view>
      </view>
      <view class="calendar-divider data-v-c9f86960"></view>
      <view class="calendar-legend data-v-c9f86960">
        <text class="legend-item legend-item--5 data-v-c9f86960"><view class="legend-dot legend-dot--5 data-v-c9f86960"></view>极佳(5)</text>
        <text class="legend-item legend-item--4 data-v-c9f86960"><view class="legend-dot legend-dot--4 data-v-c9f86960"></view>舒适(4)</text>
        <text class="legend-item legend-item--3 data-v-c9f86960"><view class="legend-dot legend-dot--3 data-v-c9f86960"></view>一般(3)</text>
        <text class="legend-item legend-item--2 data-v-c9f86960"><view class="legend-dot legend-dot--2 data-v-c9f86960"></view>较差(2)</text>
        <text class="legend-item legend-item--1 data-v-c9f86960"><view class="legend-dot legend-dot--1 data-v-c9f86960"></view>难受(1)</text>
      </view>
    </view>
    <view class="stats-row data-v-c9f86960">
      <view class="stat-card data-v-c9f86960"><text class="stat-value data-v-c9f86960">{{monthStats.worn}}/7</text><text class="stat-label data-v-c9f86960">本周佩戴</text></view>
      <view class="stat-card data-v-c9f86960"><text class="stat-value data-v-c9f86960">{{monthStats.avgHours}}h</text><text class="stat-label data-v-c9f86960">平均时长</text></view>
      <view class="stat-card data-v-c9f86960"><text class="stat-value data-v-c9f86960">{{monthStats.avgComfort}}/5</text><text class="stat-label data-v-c9f86960">舒适度</text></view>
      <view class="stat-card data-v-c9f86960"><text class="stat-value data-v-c9f86960">{{monthStats.streak}}天</text><text class="stat-label data-v-c9f86960">连续天数</text></view>
    </view>
    <view class="checkin-btn-wrap data-v-c9f86960">
      <view class="checkin-btn data-v-c9f86960" bindtap="openCheckinModal">
        <text class="checkin-btn-text data-v-c9f86960">今日打卡</text>
        <text class="checkin-btn-hint data-v-c9f86960">记录今日佩戴时长和感受</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="state-card data-v-c9f86960"><text class="state-text data-v-c9f86960">加载中...</text></view>
    <view wx:elif="{{loadError}}" class="state-card data-v-c9f86960"><text class="state-text data-v-c9f86960">{{loadError}}</text></view>
    <view wx:elif="{{!hasMonthRecords}}" class="state-card data-v-c9f86960"><text class="state-text data-v-c9f86960">当前月暂无佩戴记录</text></view>
    <view class="safe-bottom data-v-c9f86960"></view>
  </view>
  <view wx:if="{{checkinVisible}}" class="checkin-overlay data-v-c9f86960" bindtap="closeCheckinModal">
    <view class="checkin-panel data-v-c9f86960" catchtap="noop">
      <text class="checkin-panel-title data-v-c9f86960">今日佩戴打卡</text>
      <text class="checkin-panel-date data-v-c9f86960">{{checkinDateText}}</text>
      <text class="checkin-label data-v-c9f86960">佩戴时长（小时）</text>
      <scroll-view class="duration-scroll data-v-c9f86960" scroll-x="true" scroll-left="{{durationScrollLeft}}" scroll-with-animation="true" show-scrollbar="false" enhanced="true">
        <view class="duration-grid data-v-c9f86960">
          <view wx:for="{{durationOptions}}" wx:key="*this" class="duration-chip data-v-c9f86960 {{selectedWearDuration === item ? 'duration-chip--active' : ''}}" data-value="{{item}}" bindtap="handleDurationTap"><text class="data-v-c9f86960">{{item}}h</text></view>
        </view>
      </scroll-view>
      <text class="checkin-label data-v-c9f86960">舒适度评分</text>
      <view class="comfort-row data-v-c9f86960">
        <view wx:for="{{comfortOptions}}" wx:key="*this" class="comfort-star data-v-c9f86960 {{item <= selectedComfort ? 'comfort-star--active comfort-star--active-' + selectedComfort : ''}}" data-value="{{item}}" bindtap="handleComfortTap"><text class="data-v-c9f86960">{{item}}</text></view>
      </view>
      <text class="checkin-label data-v-c9f86960">备注（选填）</text>
      <textarea class="checkin-textarea data-v-c9f86960" placeholder="记录今日感受，如：轻微牙齿酸胀、睡眠质量改善..." maxlength="200" value="{{checkinNote}}" bindinput="handleNoteInput"></textarea>
      <view class="checkin-actions data-v-c9f86960">
        <view class="checkin-btn-cancel data-v-c9f86960" bindtap="closeCheckinModal"><text class="data-v-c9f86960">取消</text></view>
        <view class="checkin-btn-submit data-v-c9f86960 {{isSubmittingCheckin ? 'checkin-btn-submit--loading' : ''}}" bindtap="submitCheckin"><text class="data-v-c9f86960">{{isSubmittingCheckin ? '保存中...' : '确认打卡'}}</text></view>
      </view>
    </view>
  </view>
</view>
