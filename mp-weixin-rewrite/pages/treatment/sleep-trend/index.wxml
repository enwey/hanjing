<view class="page data-v-eb41b617">
  <hj-navbar title="睡眠趋势" showBack="{{true}}" />
  <view class="page-content data-v-eb41b617">
    <block wx:if="{{hasRealData}}">
      <view class="mode-switch data-v-eb41b617">
        <view class="mode-btn data-v-eb41b617 {{selectedRange === 'week' ? 'mode-btn--active' : ''}}" bindtap="switchToWeek">近7天</view>
        <view class="mode-btn data-v-eb41b617 {{selectedRange === 'month' ? 'mode-btn--active' : ''}}" bindtap="switchToMonth">本月</view>
      </view>
      <view class="summary-row data-v-eb41b617">
        <view class="summary-item data-v-eb41b617"><text class="summary-val data-v-eb41b617">{{wornDaysLabel}}</text><text class="summary-lbl data-v-eb41b617">记录天数</text></view>
        <view class="summary-item data-v-eb41b617"><text class="summary-val data-v-eb41b617">{{avgDurationLabel}}</text><text class="summary-lbl data-v-eb41b617">平均时长</text></view>
        <view class="summary-item data-v-eb41b617"><text class="summary-val data-v-eb41b617">{{complianceLabel}}</text><text class="summary-lbl data-v-eb41b617">达标率</text></view>
      </view>
      <view class="chart-card data-v-eb41b617">
        <text class="chart-title data-v-eb41b617">使用时长趋势</text>
        <view class="chart-bars data-v-eb41b617">
          <view wx:for="{{chartItems}}" wx:key="dateLabel" class="bar-col data-v-eb41b617">
            <text class="bar-value data-v-eb41b617 {{!item.durationLabel ? 'bar-value--zero' : ''}}">{{item.durationLabel || '0'}}</text>
            <view class="bar-fill data-v-eb41b617" style="height: {{item.barHeight}}; background: {{item.barColor}};"></view>
            <text class="bar-label data-v-eb41b617">{{item.dateLabel}}</text>
          </view>
        </view>
        <text class="chart-hint data-v-eb41b617" bindtap="openCalendar">查看完整日历</text>
      </view>
      <view class="chart-card data-v-eb41b617">
        <text class="chart-title data-v-eb41b617">舒适度记录</text>
        <view class="comfort-grid data-v-eb41b617">
          <view wx:for="{{chartItems}}" wx:key="dateLabel" class="comfort-cell data-v-eb41b617 {{item.comfortEmpty ? 'comfort-cell--empty' : ''}}">
            <view class="comfort-dots data-v-eb41b617">
              <view wx:for="{{item.comfortDots}}" wx:key="index" class="comfort-dot data-v-eb41b617 {{item.active ? 'comfort-dot--on' : ''}}"></view>
            </view>
            <text class="comfort-date data-v-eb41b617">{{item.dateLabel}}</text>
          </view>
        </view>
      </view>
      <view class="safe-bottom data-v-eb41b617"></view>
    </block>
    <view wx:elif="{{loading || loadError}}" class="empty-card data-v-eb41b617"><text class="empty-desc data-v-eb41b617">{{loading ? '正在加载睡眠趋势...' : loadError}}</text></view>
    <view wx:else class="empty-card data-v-eb41b617">
      <text class="empty-title data-v-eb41b617">暂无睡眠趋势数据</text>
      <text class="empty-desc data-v-eb41b617">当前成员还没有可展示的真实记录，完成打卡后这里会展示趋势变化。</text>
    </view>
  </view>
</view>
