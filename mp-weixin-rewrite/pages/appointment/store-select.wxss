.page {
  min-height: 100vh;
  background: #f9fafb;
}

.page-content {
  padding: 0 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
}

.section-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #9ca3af;
}

.location-sort-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #3b6bf5;
  background: #eef4ff;
  border-radius: 9999rpx;
}

.location-sort-btn::after {
  border: none;
}

.store-empty {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
