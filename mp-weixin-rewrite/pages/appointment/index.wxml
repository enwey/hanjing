<view class="page">
  <hj-navbar title="到店记录" />

  <view class="page-content">
    <view wx:if="{{loading}}" class="state-card">
      <text class="state-text">正在加载到店记录...</text>
    </view>

    <view wx:elif="{{loadError}}" class="state-card">
      <text class="state-text">{{loadError}}</text>
    </view>

    <view wx:elif="{{!loading && !loadError}}" class="apt-list">
      <block wx:if="{{historyAppointments.length > 0}}">
        <hj-appointment-item
          wx:for="{{historyAppointments}}"
          wx:key="id"
          appointment="{{item}}"
          storeName="{{item.storeName}}"
          doctorName="{{item.doctorName}}"
          cancelLimitHours="{{cancelLimitHours}}"
          bind:click="openDetail"
        />
      </block>
      <hj-empty wx:else text="暂时到店记录" icon="/static/icons/clock.svg" />
    </view>
  </view>

  <view class="safe-bottom" />
</view>
