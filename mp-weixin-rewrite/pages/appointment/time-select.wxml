<view class="page">
  <hj-navbar title="{{doctorName || '选择时段'}}" showBack="{{true}}" />

  <view class="page-content">
    <view wx:if="{{loading}}" class="state-card">
      <text class="state-title">正在加载可约时段...</text>
    </view>

    <view wx:elif="{{loadError}}" class="state-card">
      <text class="state-title">{{loadError}}</text>
      <button class="state-btn" bindtap="retryLoad">重试</button>
    </view>

    <view wx:elif="{{!scheduleDates.length}}" class="state-card">
      <text class="state-title">暂无可约日期</text>
      <text class="state-desc">请返回重新选择其他医生或门店</text>
    </view>

    <block wx:else>
      <hj-schedule-calendar
        dates="{{scheduleDates}}"
        selectedDate="{{selectedDate}}"
        bind:select="handleDateSelect"
      />

      <view wx:if="{{selectedDate}}" class="schedule-section">
        <view class="schedule-date-row">
          <text class="schedule-date">{{selectedDate}}</text>
          <text wx:if="{{loadingSchedules}}" class="schedule-loading">加载中...</text>
        </view>

        <view wx:if="{{loadingSchedules}}" class="state-card state-card--inline">
          <text class="state-title">正在加载当天排班...</text>
        </view>

        <block wx:elif="{{schedules.length > 0}}">
          <view wx:for="{{schedules}}" wx:key="id" class="schedule-group">
            <view
              class="schedule-header {{item.status === 'full' ? 'schedule-header--full' : ''}}"
              data-schedule-id="{{item.id}}"
              bindtap="handleScheduleTap"
            >
              <text class="schedule-period">{{item.periodLabel}}</text>
              <text class="schedule-time">{{item.startTime}}-{{item.endTime}}</text>
              <text class="schedule-avail">{{item.slotsLabel}}</text>
            </view>

            <view wx:if="{{selectedScheduleId === item.id}}">
              <view wx:if="{{item.loadingSlots}}" class="slot-loading">正在加载时段...</view>
              <view wx:elif="{{item.timeSlots.length > 0}}" class="slot-grid">
                <view
                  wx:for="{{item.timeSlots}}"
                  wx:for-item="slot"
                  wx:key="id"
                  class="slot {{slot.isAvailable ? 'slot--available' : ''}} {{slot.status === 'booked' ? 'slot--booked' : ''}} {{slot.status === 'disabled' ? 'slot--disabled' : ''}}"
                  data-schedule-id="{{item.id}}"
                  data-time-slot-id="{{slot.id}}"
                  bindtap="handleTimeSlotTap"
                >
                  <text class="slot-time">{{slot.label}}</text>
                </view>
              </view>
              <view wx:else class="slot-loading">该排班暂无可约时段</view>
            </view>
          </view>
        </block>

        <view wx:else class="empty-text">该日期暂无可约时段</view>
      </view>

      <view wx:else class="select-hint">
        <text>请选择就诊日期</text>
      </view>
    </block>
  </view>
</view>
