<view class="page">
  <hj-navbar title="选择医生" showBack="{{true}}" />

  <view class="page-content">
    <view class="section-header">
      <text class="section-title">选择医生</text>
      <text class="section-hint">共 {{doctors.length}} 位医生</text>
    </view>

    <view wx:if="{{loading}}" class="empty-state"><text>正在加载医生...</text></view>
    <view wx:elif="{{loadError}}" class="empty-state">
      <text>{{loadError}}</text>
      <button bindtap="loadPage">重试</button>
    </view>
    <view wx:elif="{{doctors.length > 0}}">
      <view
        wx:for="{{doctors}}"
        wx:key="id"
        class="doctor-wrapper"
        data-doctor-id="{{item.id}}"
        bindtap="handleDoctorTap"
      >
        <hj-doctor-card doctor="{{item}}" />
      </view>
    </view>

    <view wx:else class="empty-state">
      <text class="empty-text">该门店暂无医生排班</text>
    </view>
  </view>
</view>
