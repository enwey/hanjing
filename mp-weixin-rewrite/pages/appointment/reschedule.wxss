.page {
  min-height: 100vh;
  background: #f9fafb;
}

.page-content {
  padding: 0 32rpx 200rpx;
}

.state-card {
  padding: 80rpx 0;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.schedule-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.schedule-period {
  margin-right: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.schedule-time {
  font-size: 28rpx;
  color: #6b7280;
}

.slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.slot {
  width: calc((100% - 32rpx) / 3);
  padding: 24rpx 0;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
  font-size: 28rpx;
  color: #1f2937;
}

.slot--available {
  border-color: #3b6bf5;
  color: #3b6bf5;
}

.slot--selected {
  border-color: #3b6bf5;
  background: #3b6bf5;
  color: #ffffff;
}

.slot--booked {
  background: #f9fafb;
  color: #d1d5db;
  pointer-events: none;
}

.empty-card {
  padding: 80rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9ca3af;
}

.bottom-fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom, 34px) + 24rpx);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(18rpx);
}

.bar-primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #3b6bf5 0%, #5a85f5 50%, #8eafff 100%);
  box-shadow: 0 8rpx 28rpx rgba(59, 107, 245, 0.25);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.bar-primary-btn::after {
  border: none;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom, 34px) + 40rpx);
}
