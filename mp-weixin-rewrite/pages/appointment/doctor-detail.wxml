<view class="page">
  <hj-navbar title="顾问详情" showBack="{{true}}" />

  <view class="page-content" wx:if="{{doctorLoaded}}">
    <view class="doctor-detail-hero">
      <view class="doc-avatar">
        <image
          wx:if="{{!avatarLoaded}}"
          class="doc-avatar-placeholder"
          src="/static/images/brand-koala.png"
          mode="aspectFill"
        />
        <image
          wx:if="{{avatarUrl}}"
          class="doc-avatar-image {{avatarLoaded ? 'doc-avatar-image--loaded' : ''}}"
          src="{{avatarUrl}}"
          mode="aspectFill"
          bindload="handleAvatarLoad"
          binderror="handleAvatarError"
        />
      </view>
      <view class="doc-name">{{doctorName}}</view>
      <view class="doc-title-text">{{doctorTitle}} · {{specialty}}</view>
      <view class="doc-tags">
        <text wx:for="{{heroTags}}" wx:key="*this" class="doc-hero-tag">{{item}}</text>
      </view>
    </view>

    <view class="doc-stats-row">
      <view class="doc-stat">
        <view class="val">
          <text>{{experienceNumber}}</text>
          <text class="unit">年</text>
        </view>
        <view class="lab">临床经验</view>
      </view>
      <view class="doc-stat">
        <view class="val">
          <text>{{consultCountLabel}}</text>
          <text class="unit">+</text>
        </view>
        <view class="lab">累计诊疗</view>
      </view>
      <view class="doc-stat">
        <view class="val">
          <text>{{ratingLabel}}</text>
          <text class="unit">%</text>
        </view>
        <view class="lab">好评率</view>
      </view>
    </view>

    <view class="doc-section">
      <view class="doc-section-title">
        <image class="doc-section-icon" src="/static/icons/profile-settings.svg" />
        个人简介
      </view>
      <view class="doc-intro">{{introText}}</view>
    </view>

    <view class="doc-section">
      <view class="doc-section-title">
        <image class="doc-section-icon" src="/static/icons/treatment_green.svg" />
        擅长领域
      </view>
      <view class="doc-specialties">
        <text wx:for="{{expertiseTags}}" wx:key="*this" class="doc-spec-tag">{{item}}</text>
      </view>
    </view>

  </view>
</view>
