WECHAT_APPOINTMENT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/appointments/pay-callback
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/v1/pay/refund-callback
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_CERT=
