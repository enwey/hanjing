# MySQL Database Configurations
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=hanjing_clinic

# Express Server Configuration
PORT=5005
NODE_ENV=development
# Required for production. Generate two independent keys; never rotate PII without data migration.
JWT_SECRET=
PII_ENCRYPTION_KEY=
# Exact browser origins and trusted reverse-proxy IPs/CIDRs, comma-separated.
CORS_ORIGINS=
TRUSTED_PROXY_CIDRS=

# WeChat Mini Program Live
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
# Simulation is disabled; real provider configuration is required.
ENABLE_MOCK_WX_LOGIN=false

# WeChat Pay v3
# This legacy flag cannot enable simulated payments.
ENABLE_MOCK_WECHAT_PAY=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_API_V2_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/orders/pay-callback
WECHAT_APPOINTMENT_PAY_NOTIFY_URL=https://your-domain.com/api/v1/appointments/pay-callback
WECHAT_PAY_REFUND_NOTIFY_URL=https://your-domain.com/api/v1/pay/refund-callback
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_PLATFORM_CERT=
